---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import SectionHeader from "@/components/SectionHeader.astro";
import RefTags from "@/components/RefTags.astro";
import type { Locale } from "@/lib/seo";
import { t } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const all = await getCollection("mechanisms");
// Preserve the source ordering from the original site.
const order = ["hyperoxygenation", "angiogenesis", "antimicrobial", "gas-reduction", "antiaging"];
const mechanisms = order
  .map((id) => all.find((m) => m.id === id))
  .filter((m): m is NonNullable<typeof m> => m !== undefined);

const iconMap: Record<string, string> = {
  Droplets: "lucide:droplets",
  GitBranch: "lucide:git-branch",
  Shield: "lucide:shield",
  Minimize2: "lucide:minimize-2",
  RefreshCw: "lucide:refresh-cw",
};

const stats = [
  { value: "+42%", label: t("mechanisms.stat1.label", locale), sub: t("mechanisms.stat1.sub", locale) },
  { value: "−25%", label: t("mechanisms.stat2.label", locale), sub: t("mechanisms.stat2.sub", locale) },
  { value: t("mechanisms.stat3.value", locale), label: t("mechanisms.stat3.label", locale), sub: t("mechanisms.stat3.sub", locale) },
];
---

<section id="mechanisms" class="py-20 bg-white scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader
      badge={t("mechanisms.section.badge", locale)}
      title={t("mechanisms.section.title", locale)}
      subtitle={t("mechanisms.section.subtitle", locale)}
      badgeColor="teal"
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        mechanisms.map((m, i) => {
          const isTeal = m.data.color === "teal";
          const accent = isTeal ? "bg-teal-500" : "bg-slate-700";
          const iconBg = isTeal ? "bg-teal-100 text-teal-700" : "bg-slate-100 text-slate-700";
          return (
            <article class="rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden">
              <div class={`h-1 ${accent}`} aria-hidden="true" />
              <div class="p-6">
                <div class="flex items-center gap-3 mb-4">
                  <div class={`w-10 h-10 rounded-lg ${iconBg} flex items-center justify-center`}>
                    <Icon name={iconMap[m.data.icon] ?? "lucide:circle"} class="w-5 h-5" />
                  </div>
                  <span class="text-xs font-semibold tracking-wider text-slate-400">
                    0{i + 1}
                  </span>
                </div>

                <h3 class="text-lg font-semibold text-slate-900 leading-snug" style="font-family: var(--font-display)">
                  {m.data.title[locale]}
                </h3>

                <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                  {m.data.summary[locale]}
                </p>

                <details class="mt-4 group">
                  <summary class="cursor-pointer text-xs font-semibold text-teal-700 hover:text-teal-800 list-none flex items-center gap-1">
                    <span class="group-open:hidden">{t("mechanisms.detail.label", locale)}</span>
                    <span class="hidden group-open:inline">{t("mechanisms.collapse.label", locale)}</span>
                    <Icon name="lucide:chevron-down" class="w-3.5 h-3.5 transition-transform group-open:rotate-180" />
                  </summary>
                  <p class="mt-3 text-sm text-slate-700 leading-relaxed">
                    {m.data.detail[locale]}
                  </p>
                </details>

                {m.data.refs.length > 0 && (
                  <div class="mt-4 pt-4 border-t border-slate-100">
                    <RefTags refs={m.data.refs} label={t("mechanisms.refs.label", locale)} />
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Hyperoxic-Hypoxic Paradox banner -->
    <div class="mt-12 rounded-2xl overflow-hidden bg-gradient-to-r from-slate-900 to-teal-900 text-white p-8 md:p-10">
      <div class="grid md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2">
          <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-500/20 text-teal-200 border border-teal-400/30">
            {t("mechanisms.banner.badge", locale)}
          </span>
          <h3 class="mt-3 text-2xl font-semibold" style="font-family: var(--font-display)">
            {t("mechanisms.banner.title", locale)}
          </h3>
          <p class="mt-3 text-slate-200 leading-relaxed text-sm">
            {t("mechanisms.banner.body", locale)}
          </p>
        </div>
        <div class="grid grid-cols-1 gap-3">
          {
            stats.map((s) => (
              <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                <p class="text-2xl font-bold text-teal-300">{s.value}</p>
                <p class="text-xs font-semibold text-white">{s.label}</p>
                <p class="text-xs text-slate-300">{s.sub}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
