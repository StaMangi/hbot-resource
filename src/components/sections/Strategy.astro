---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import SectionHeader from "@/components/SectionHeader.astro";
import type { Locale } from "@/lib/seo";
import { t } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const all = await getCollection("strategic-recommendations");
const order = ["unit", "clinical", "wellness", "research"];
const recs = order
  .map((id) => all.find((r) => r.id === id))
  .filter((r): r is NonNullable<typeof r> => r !== undefined);

const iconMap: Record<string, string> = {
  Building2: "lucide:building-2",
  ClipboardList: "lucide:clipboard-list",
  Sparkles: "lucide:sparkles",
  FlaskConical: "lucide:flask-conical",
  TrendingUp: "lucide:trending-up",
};

const priorityBadge = (p: string) =>
  p === "High"
    ? "bg-rose-100 text-rose-800 border-rose-200"
    : p === "Medium"
      ? "bg-amber-100 text-amber-800 border-amber-200"
      : "bg-slate-100 text-slate-700 border-slate-200";

const priorityLabel = (p: string) =>
  p === "High" ? t("strategy.priority.high", locale) : t("strategy.priority.medium", locale);

// Stats: rebuilt the deleted stat2 slot with "258+ Peer-reviewed citations"
// per Phase 2.D — see migrate-i18n.mjs notes for the rationale.
const marketStats = [
  { val: "$44.2B", label: t("strategy.market.stat1", locale) },
  { val: t("strategy.market.stat2.val", locale), label: t("strategy.market.stat2", locale) },
  { val: t("strategy.market.stat3.val", locale), label: t("strategy.market.stat3", locale) },
];
---

<section id="strategy" class="py-20 bg-slate-50 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader
      badge={t("strategy.section.badge", locale)}
      title={t("strategy.section.title", locale)}
      subtitle={t("strategy.section.subtitle", locale)}
      badgeColor="navy"
    />

    <div class="grid md:grid-cols-2 gap-6">
      {
        recs.map((rec, i) => (
          <article class="rounded-xl bg-white border border-slate-200 shadow-sm p-6">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center">
                  <Icon name={iconMap[rec.data.icon] ?? "lucide:circle"} class="w-5 h-5" />
                </div>
                <span class="text-xs font-semibold tracking-wider uppercase text-slate-500">
                  {`Phase ${i + 1}`}
                </span>
              </div>
              <span class={`inline-block px-2.5 py-0.5 text-xs font-semibold rounded-md border ${priorityBadge(rec.data.priority)}`}>
                {priorityLabel(rec.data.priority)}
              </span>
            </div>

            <h3 class="text-lg font-semibold text-slate-900 mb-2" style="font-family: var(--font-display)">
              {rec.data.title[locale]}
            </h3>

            <p class="text-sm text-slate-600 leading-relaxed mb-4">
              {rec.data.description[locale]}
            </p>

            <div class="rounded-lg bg-slate-50 border border-slate-200 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">
                {t("strategy.actions.label", locale)}
              </p>
              <ul class="space-y-2">
                {rec.data.actions[locale].map((action) => (
                  <li class="flex items-start gap-2 text-sm text-slate-700">
                    <Icon name="lucide:chevron-right" class="w-3.5 h-3.5 text-teal-700 mt-0.5 flex-shrink-0" />
                    <span>{action}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Market positioning banner with three stats (stat2 rebuilt for 2.D) -->
    <div class="mt-12 rounded-2xl bg-gradient-to-r from-slate-900 via-slate-800 to-teal-900 text-white p-8 md:p-10">
      <div class="grid md:grid-cols-3 gap-6 items-center">
        <div class="md:col-span-2">
          <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-500/20 text-teal-200 border border-teal-400/30">
            {t("strategy.market.badge", locale)}
          </span>
          <h3 class="mt-3 text-2xl font-semibold" style="font-family: var(--font-display)">
            {t("strategy.market.title", locale)}
          </h3>
          <p class="mt-3 text-sm text-slate-200 leading-relaxed">
            {t("strategy.market.body", locale)}
          </p>
        </div>
        <div class="grid grid-cols-1 gap-3">
          {
            marketStats.map((s) => (
              <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                <p class="text-2xl font-bold text-teal-300">{s.val}</p>
                <p class="text-xs text-slate-200">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
