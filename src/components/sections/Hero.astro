---
import { Icon } from "astro-icon/components";
import type { Locale } from "@/lib/seo";
import { t } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Stat values are layout-invariant; only labels are translated.
const stats = [
  { icon: "lucide:award", value: "14", label: t("stat.fda.label", locale), sub: t("stat.fda.sub", locale) },
  { icon: "lucide:trending-up", value: ">20%", label: t("stat.telomere.label", locale), sub: t("stat.telomere.sub", locale) },
  { icon: "lucide:book-open", value: "258", label: t("stat.citations.label", locale), sub: t("stat.citations.sub", locale) },
  { icon: "lucide:gauge", value: "2–3", label: t("stat.pressure.label", locale), sub: t("stat.pressure.sub", locale) },
];

const departmentsHref = locale === "en" ? "#departments" : "/el/#departments";
const fdaHref = locale === "en" ? "#fda" : "/el/#fda";
---

<section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-900 to-teal-900 text-white">
  <!-- Decorative blur circles -->
  <div class="pointer-events-none absolute -top-20 -left-20 w-72 h-72 rounded-full bg-teal-500/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-0 right-0 w-96 h-96 rounded-full bg-cyan-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 md:py-28 grid lg:grid-cols-2 gap-12 items-center">
    <!-- Left column: text -->
    <div>
      <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-500/20 text-teal-200 border border-teal-400/30">
        {t("hero.badge", locale)}
      </span>

      <h1
        class="mt-6 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
        style="font-family: var(--font-display)"
      >
        <span class="block">{t("hero.title1", locale)}</span>
        <span class="block bg-gradient-to-r from-teal-300 to-cyan-300 bg-clip-text text-transparent">
          {t("hero.title2", locale)}
        </span>
        <span class="block text-2xl md:text-3xl mt-2 text-slate-300 font-medium">
          {t("hero.title3", locale)}
        </span>
      </h1>

      <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-xl">
        {t("hero.description", locale)}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={departmentsHref}
          class="inline-flex items-center px-5 py-3 rounded-lg bg-teal-500 hover:bg-teal-400 text-slate-900 font-semibold transition-colors"
        >
          {t("hero.cta.departments", locale)}
        </a>
        <a
          href={fdaHref}
          class="inline-flex items-center px-5 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold border border-white/20 backdrop-blur-sm transition-colors"
        >
          {t("hero.cta.fda", locale)}
        </a>
      </div>
    </div>

    <!-- Right column: 2x2 stat grid -->
    <div class="grid grid-cols-2 gap-4">
      {
        stats.map((s) => (
          <div class="bg-white/5 border border-white/10 rounded-xl p-5 backdrop-blur-sm">
            <Icon name={s.icon} class="w-6 h-6 text-teal-300 mb-3" />
            <p class="text-3xl font-bold text-white" style="font-family: var(--font-display)">
              {s.value}
            </p>
            <p class="mt-1 text-sm font-semibold text-slate-200">{s.label}</p>
            <p class="mt-1 text-xs text-slate-400">{s.sub}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
