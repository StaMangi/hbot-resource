---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import SectionHeader from "@/components/SectionHeader.astro";
import ProtocolPanel from "@/components/ProtocolPanel.astro";
import RefTags from "@/components/RefTags.astro";
import type { Locale } from "@/lib/seo";
import { t } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const all = await getCollection("departments");
// Preserve clinical ordering from the original site.
const order = [
  "surgery",
  "neurology",
  "oncology",
  "gastroenterology",
  "endocrinology",
  "ent",
  "ophthalmology",
  "psychiatry",
  "geriatrics",
];
const departments = order
  .map((id) => all.find((d) => d.id === id))
  .filter((d): d is NonNullable<typeof d> => d !== undefined);

const iconMap: Record<string, string> = {
  Scissors: "lucide:scissors",
  Brain: "lucide:brain",
  Activity: "lucide:activity",
  Stethoscope: "lucide:stethoscope",
  Zap: "lucide:zap",
  Ear: "lucide:ear",
  Eye: "lucide:eye",
  HeartHandshake: "lucide:heart-handshake",
  Users: "lucide:users",
};

const typeBadge = (type: string) =>
  type === "FDA-Approved"
    ? "bg-emerald-100 text-emerald-800"
    : type === "Under Research"
      ? "bg-sky-100 text-sky-800"
      : "bg-slate-100 text-slate-700";

const typeLabel = (type: string) => {
  if (type === "FDA-Approved") return t("dept.type.approved", locale);
  if (type === "Under Research") return t("dept.type.research", locale);
  if (type === "Emerging Evidence") return t("dept.type.emerging", locale);
  return t("dept.type.investigational", locale);
};
---

<section id="departments" class="py-20 bg-white scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader
      badge={t("dept.section.badge", locale)}
      title={t("dept.section.title", locale)}
      subtitle={t("dept.section.subtitle", locale)}
      badgeColor="teal"
    />

    <div class="space-y-10">
      {
        departments.map((dept) => {
          const fdaCount = dept.data.applications.filter((a) => a.type === "FDA-Approved").length;
          const researchCount = dept.data.applications.length - fdaCount;
          return (
            <article id={`dept-${dept.id}`} class="rounded-2xl border border-slate-200 overflow-hidden scroll-mt-20">
              {/* Header band — uses department's own colour as a subtle accent */}
              <div
                class="px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-white"
                style={`background: linear-gradient(135deg, ${dept.data.color}, ${dept.data.color}cc)`}
              >
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 rounded-lg bg-white/15 flex items-center justify-center backdrop-blur-sm">
                    <Icon name={iconMap[dept.data.icon] ?? "lucide:circle"} class="w-5 h-5" />
                  </div>
                  <div>
                    <h3 class="text-xl font-semibold" style="font-family: var(--font-display)">
                      {dept.data.name[locale]}
                    </h3>
                    <p class="text-sm text-white/85">{dept.data.shortDesc[locale]}</p>
                  </div>
                </div>
                <div class="flex gap-3 text-sm">
                  <div class="bg-white/15 rounded-md px-3 py-1.5 backdrop-blur-sm">
                    <span class="font-bold">{fdaCount}</span>{" "}
                    <span class="text-white/85">{t("dept.counter.fda", locale)}</span>
                  </div>
                  <div class="bg-white/15 rounded-md px-3 py-1.5 backdrop-blur-sm">
                    <span class="font-bold">{researchCount}</span>{" "}
                    <span class="text-white/85">{t("dept.counter.research", locale)}</span>
                  </div>
                </div>
              </div>

              <div class="bg-slate-50 p-6 grid md:grid-cols-2 gap-4">
                {dept.data.applications.map((app) => (
                  <div class="rounded-lg bg-white border border-slate-200 p-5 flex flex-col">
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class={`inline-block px-2 py-0.5 text-xs font-semibold rounded-md ${typeBadge(app.type)}`}>
                        {typeLabel(app.type)}
                      </span>
                      <span class="text-xs text-slate-500">{app.evidence}</span>
                    </div>
                    <h4 class="text-base font-semibold text-slate-900 leading-snug mb-2">
                      {app.title[locale]}
                    </h4>
                    <p class="text-sm text-slate-600 leading-relaxed flex-1">
                      {app.description[locale]}
                    </p>
                    <ProtocolPanel protocol={app.protocol} locale={locale} />
                    {app.refs.length > 0 && (
                      <div class="mt-3">
                        <RefTags refs={app.refs} label={t("dept.refs.label", locale)} />
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
