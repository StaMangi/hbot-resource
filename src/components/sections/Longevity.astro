---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import SectionHeader from "@/components/SectionHeader.astro";
import ProtocolPanel from "@/components/ProtocolPanel.astro";
import RefTags from "@/components/RefTags.astro";
import type { Locale } from "@/lib/seo";
import { t, has } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const all = await getCollection("longevity");
const order = ["telomere", "senescence", "cognitive", "stemcells", "athletic", "collagen"];
const apps = order
  .map((id) => all.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => a !== undefined);

const iconMap: Record<string, string> = {
  Dna: "lucide:dna",
  Trash2: "lucide:trash-2",
  Brain: "lucide:brain",
  Sparkles: "lucide:sparkles",
  Zap: "lucide:zap",
  Layers: "lucide:layers",
};

// Landmark study + wellness callout subsections only render in EL — those keys
// don't exist in EN (Phase 3 audit item: backfill EN or remove dead EL keys).
const showLandmark = has("longevity.landmark.body", locale);
const showWellness =
  has("longevity.wellness.cognitive.title", locale) &&
  has("longevity.wellness.athletic.title", locale);
---

<section id="longevity" class="py-20 bg-gradient-to-b from-slate-50 via-white to-cyan-50/30 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader
      badge={t("longevity.section.badge", locale)}
      title={t("longevity.section.title", locale)}
      subtitle={t("longevity.section.subtitle", locale)}
      badgeColor="violet"
    />

    {/* Landmark study banner — EL only for now */}
    {
      showLandmark && (
        <div class="mb-12 rounded-2xl overflow-hidden bg-gradient-to-r from-slate-900 via-teal-900 to-slate-900 text-white p-8 md:p-10">
          <div class="grid md:grid-cols-3 gap-6 items-center">
            <div class="md:col-span-2">
              <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-500/20 text-teal-200 border border-teal-400/30">
                {t("longevity.landmark.badge", locale)}
              </span>
              <p class="mt-3 italic text-teal-200">{t("longevity.landmark.quote", locale)}</p>
              <p class="mt-3 text-sm text-slate-200 leading-relaxed">
                {t("longevity.landmark.body", locale)}
              </p>
            </div>
            <div class="grid grid-cols-2 gap-3 text-sm">
              {has("longevity.stat.telomere", locale) && (
                <div class="bg-white/5 rounded-lg p-3">
                  <p class="text-2xl font-bold text-teal-300">+20%</p>
                  <p class="text-xs text-slate-300">{t("longevity.stat.telomere", locale)}</p>
                </div>
              )}
              {has("longevity.stat.senescent", locale) && (
                <div class="bg-white/5 rounded-lg p-3">
                  <p class="text-2xl font-bold text-teal-300">−37%</p>
                  <p class="text-xs text-slate-300">{t("longevity.stat.senescent", locale)}</p>
                </div>
              )}
              {has("longevity.stat.sessions", locale) && (
                <div class="bg-white/5 rounded-lg p-3">
                  <p class="text-2xl font-bold text-teal-300">60</p>
                  <p class="text-xs text-slate-300">{t("longevity.stat.sessions", locale)}</p>
                </div>
              )}
              {has("longevity.stat.pressure", locale) && (
                <div class="bg-white/5 rounded-lg p-3">
                  <p class="text-2xl font-bold text-teal-300">2.0 ATA</p>
                  <p class="text-xs text-slate-300">{t("longevity.stat.pressure", locale)}</p>
                </div>
              )}
            </div>
          </div>
        </div>
      )
    }

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        apps.map((app) => {
          const isTeal = app.data.color === "teal";
          const accent = isTeal ? "bg-teal-500" : "bg-slate-700";
          const iconBg = isTeal ? "bg-teal-100 text-teal-700" : "bg-slate-100 text-slate-700";
          return (
            <article class="rounded-xl bg-white border border-slate-200 shadow-sm overflow-hidden flex flex-col">
              <div class={`h-1 ${accent}`} aria-hidden="true" />
              <div class="p-6 flex-1 flex flex-col">
                <div class="flex items-center justify-between gap-3 mb-3">
                  <div class={`w-10 h-10 rounded-lg ${iconBg} flex items-center justify-center`}>
                    <Icon name={iconMap[app.data.icon] ?? "lucide:circle"} class="w-5 h-5" />
                  </div>
                  <div class="text-right">
                    <p class="text-2xl font-bold text-teal-700" style="font-family: var(--font-display)">
                      {app.data.stat}
                    </p>
                    <p class="text-xs text-slate-500">{app.data.statLabel[locale]}</p>
                  </div>
                </div>
                <h3 class="text-base font-semibold text-slate-900 leading-snug mb-2" style="font-family: var(--font-display)">
                  {app.data.title[locale]}
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                  {app.data.summary[locale]}
                </p>
                <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 mb-3">
                  <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                    {t("mechanisms.detail.label", locale)}
                  </p>
                  <p class="text-xs text-slate-700 leading-relaxed">{app.data.mechanism[locale]}</p>
                </div>
                <ProtocolPanel protocol={app.data.protocol} locale={locale} />
                {app.data.refs && app.data.refs.length > 0 && (
                  <div class="mt-3">
                    <RefTags refs={app.data.refs} label={t("longevity.refs.label", locale)} />
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </div>

    {/* Wellness program callouts — EL only for now */}
    {
      showWellness && (
        <div class="mt-12 grid md:grid-cols-2 gap-5">
          <div class="rounded-xl border-2 border-violet-200 bg-violet-50 p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-violet-700">
              {t("longevity.wellness.cognitive.tag", locale)}
            </p>
            <h3 class="mt-2 text-lg font-semibold text-slate-900" style="font-family: var(--font-display)">
              {t("longevity.wellness.cognitive.title", locale)}
            </h3>
            <p class="mt-2 text-sm text-slate-700 leading-relaxed">
              {t("longevity.wellness.cognitive.desc", locale)}
            </p>
          </div>
          <div class="rounded-xl border-2 border-teal-200 bg-teal-50 p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-teal-700">
              {t("longevity.wellness.athletic.tag", locale)}
            </p>
            <h3 class="mt-2 text-lg font-semibold text-slate-900" style="font-family: var(--font-display)">
              {t("longevity.wellness.athletic.title", locale)}
            </h3>
            <p class="mt-2 text-sm text-slate-700 leading-relaxed">
              {t("longevity.wellness.athletic.desc", locale)}
            </p>
          </div>
        </div>
      )
    }

    <!-- Hyperoxic-Hypoxic Paradox callout (shared with mechanisms but framed as longevity) -->
    <div class="mt-12 rounded-xl border border-teal-200 bg-teal-50/50 p-6 md:p-8">
      <h3 class="text-xl font-semibold text-slate-900 mb-3" style="font-family: var(--font-display)">
        {t("longevity.callout.title", locale)}
      </h3>
      <p class="text-sm text-slate-700 leading-relaxed">{t("longevity.callout.body", locale)}</p>
    </div>
  </div>
</section>
