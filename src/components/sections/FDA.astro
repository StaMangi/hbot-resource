---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import SectionHeader from "@/components/SectionHeader.astro";
import ProtocolPanel from "@/components/ProtocolPanel.astro";
import RefTags from "@/components/RefTags.astro";
import type { Locale } from "@/lib/seo";
import { t } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const all = await getCollection("indications");
// Preserve original numeric order via legacyId.
const indications = all.sort((a, b) => a.data.legacyId - b.data.legacyId);

// Card view only (the table/card toggle from the original is deferred — Phase 2.E).
// Cards are more readable on mobile and equivalent for SEO indexing of structured data.

const evidenceBadge = (level: string) =>
  level === "A"
    ? "bg-emerald-100 text-emerald-800 border-emerald-200"
    : level === "B"
      ? "bg-sky-100 text-sky-800 border-sky-200"
      : "bg-slate-100 text-slate-700 border-slate-200";
---

<section id="fda" class="py-20 bg-slate-50 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader
      badge={t("fda.section.badge", locale)}
      title={t("fda.section.title", locale)}
      subtitle={t("fda.section.subtitle", locale)}
      badgeColor="emerald"
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        indications.map((ind) => (
          <article
            id={`fda-${ind.id}`}
            class="rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col scroll-mt-20"
          >
            <div class="flex items-start justify-between gap-3 mb-3">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-emerald-100 text-emerald-800 font-bold text-sm">
                {ind.data.legacyId}
              </span>
              <span
                class={`inline-block px-2.5 py-0.5 text-xs font-semibold rounded-md border ${evidenceBadge(ind.data.evidenceLevel)}`}
              >
                {`Level ${ind.data.evidenceLevel}`}
              </span>
            </div>

            <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">
              {ind.data.category[locale]}
            </p>
            <h3 class="text-base font-semibold text-slate-900 leading-snug mb-2" style="font-family: var(--font-display)">
              {ind.data.condition[locale]}
            </h3>

            <p class="text-sm text-slate-600 leading-relaxed flex-1">
              {ind.data.description[locale]}
            </p>

            <div class="mt-2 flex items-center gap-1.5 text-xs text-emerald-700">
              <Icon name="lucide:check-circle-2" class="w-3.5 h-3.5" />
              <span>{ind.data.evidence[locale]}</span>
            </div>

            <ProtocolPanel protocol={ind.data.protocol} locale={locale} />

            {ind.data.refs.length > 0 && (
              <div class="mt-3">
                <RefTags refs={ind.data.refs} />
              </div>
            )}
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-slate-500 max-w-3xl mx-auto text-center">
      {t("fda.note", locale)}
    </p>
  </div>
</section>
