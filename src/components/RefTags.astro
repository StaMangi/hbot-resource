---
// Static reference badges on detail pages. Each badge anchor-links to
// `${prefix}/references/#ref-{N}` — a *cross-page* anchor, since the full
// references list lives at `/references/` (or `/el/references/`), not
// inline on the detail page. The browser navigates to the references
// page and scrolls to the matching `<li id="ref-N">` set by
// ReferenceItem.astro.
//
// `prefix` is "" for EN callsites and "/el" for EL callsites, matching
// the locale-prefix convention used elsewhere on the site.

interface Props {
  refs: string[];
  label?: string;
  prefix?: string;
}

const { refs, label, prefix = "" } = Astro.props;

// Source format is "[1]" — strip brackets for display + slug.
function parse(raw: string): string {
  return raw.replace(/[\[\]]/g, "");
}
---

<div class="flex flex-wrap items-center gap-2">
  {label && <span class="text-xs text-slate-500">{label}</span>}
  {
    refs.map((raw) => {
      const num = parse(raw);
      return (
        <a
          href={`${prefix}/references/#ref-${num}`}
          class="inline-flex items-center justify-center min-w-[1.75rem] h-7 px-2 rounded-md text-xs font-semibold border border-teal-300 bg-teal-50 text-teal-800 hover:bg-teal-700 hover:text-white transition-colors"
          aria-label={`Reference ${num}`}
        >
          {num}
        </a>
      );
    })
  }
</div>
