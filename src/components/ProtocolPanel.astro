---
import { Icon } from "astro-icon/components";
import type { Locale } from "@/lib/seo";

interface Protocol {
  // All five fields are multilingual. ata + duration joined the set late in
  // Phase 7 — the endometriosis entry surfaced prose values ("Not
  // standardised") that needed locale-specific translation. `it` is optional
  // during the Phase 7.B rollout (warn-not-fail), required at Stage 6.
  ata: { en: string; el: string; de: string; it?: string };
  duration: { en: string; el: string; de: string; it?: string };
  sessions: { en: string; el: string; de: string; it?: string };
  frequency: { en: string; el: string; de: string; it?: string };
  basis: { en: string; el: string; de: string; it?: string };
}

interface Props {
  protocol: Protocol;
  locale: Locale;
  variant?: "compact" | "full";
}

const { protocol, locale, variant = "compact" } = Astro.props;

const labels = {
  en: {
    protocol: "Protocol",
    pressure: "Pressure",
    duration: "Duration",
    sessions: "Sessions",
    frequency: "Frequency",
    basis: "Evidence basis",
  },
  el: {
    protocol: "Πρωτόκολλο",
    pressure: "Πίεση",
    duration: "Διάρκεια",
    sessions: "Συνεδρίες",
    frequency: "Συχνότητα",
    basis: "Τεκμηρίωση",
  },
  de: {
    protocol: "Protokoll",
    pressure: "Druck",
    duration: "Dauer",
    sessions: "Sitzungen",
    frequency: "Frequenz",
    basis: "Evidenzgrundlage",
  },
  it: {
    protocol: "Protocollo",
    pressure: "Pressione",
    duration: "Durata",
    sessions: "Sedute",
    frequency: "Frequenza",
    basis: "Base di evidenza",
  },
}[locale];

const fields = [
  { icon: "lucide:gauge", label: labels.pressure, value: protocol.ata[locale] },
  { icon: "lucide:clock", label: labels.duration, value: protocol.duration[locale] },
  { icon: "lucide:hash", label: labels.sessions, value: protocol.sessions[locale] },
  { icon: "lucide:refresh-cw", label: labels.frequency, value: protocol.frequency[locale] },
];

const grid = variant === "full" ? "grid-cols-2 md:grid-cols-4" : "grid-cols-2";
---

<div class="rounded-lg border border-teal-200 bg-teal-50/40 p-4 mt-3">
  <p class="text-xs font-semibold tracking-wider uppercase text-teal-800 mb-3">
    {labels.protocol}
  </p>

  <div class={`grid gap-3 ${grid}`}>
    {
      fields.map((f) => (
        <div class="flex items-start gap-2">
          <Icon name={f.icon} class="w-4 h-4 text-teal-700 mt-0.5 flex-shrink-0" />
          <div class="min-w-0">
            <p class="text-xs uppercase tracking-wider text-slate-500">{f.label}</p>
            <p class="text-sm text-slate-800 break-words">{f.value}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-3 pt-3 border-t border-teal-200 flex items-start gap-2">
    <Icon name="lucide:book-open" class="w-3.5 h-3.5 text-teal-700 mt-0.5 flex-shrink-0" />
    <p class="text-xs text-slate-600">
      <span class="font-semibold text-slate-700">{labels.basis}:</span>{" "}
      {protocol.basis[locale]}
    </p>
  </div>
</div>
