---
import type { CrossRef } from "@/lib/cross-links";
import type { Locale } from "@/lib/seo";

interface Props {
  /** Heading shown above the list (already-localised by the caller). */
  title: string;
  related: CrossRef[];
  locale: Locale;
  prefix?: string;
}

const { title, related, locale, prefix = "" } = Astro.props;

const collectionLabel = (c: CrossRef["collection"]) => {
  const labels = {
    en: { mechanisms: "Mechanism", indications: "Indication", departments: "Department", longevity: "Longevity" },
    el: { mechanisms: "Μηχανισμός", indications: "Ένδειξη", departments: "Τμήμα", longevity: "Μακροζωία" },
    de: { mechanisms: "Mechanismus", indications: "Indikation", departments: "Fachbereich", longevity: "Langlebigkeit" },
  };
  return labels[locale][c];
};
---

{
  related.length > 0 && (
    <div class="rounded-lg border border-slate-200 bg-slate-50/50 p-5">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">
        {title}
      </h3>
      <ul class="space-y-2.5">
        {related.map((r) => (
          <li>
            <a
              href={`${prefix}/${r.collection}/${r.slug}/`}
              class="group block hover:text-teal-700 transition-colors"
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                {collectionLabel(r.collection)}
              </p>
              <p class="text-sm font-medium text-slate-800 leading-snug group-hover:text-teal-700">
                {r.title[locale]}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
