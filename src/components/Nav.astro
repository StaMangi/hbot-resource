---
import { localePath, type Locale } from "@/lib/seo";
import { t } from "@/i18n";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const altLocale: Locale = locale === "en" ? "el" : "en";
const altPath = localePath(pathname, altLocale);
const home = locale === "en" ? "/" : "/el/";
const altLabel = altLocale === "el" ? "Ελληνικά" : "English";
---

<nav class="border-b border-slate-200 bg-white">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a
      href={home}
      class="text-xl font-semibold text-slate-900 hover:text-teal-700 transition-colors"
      style="font-family: var(--font-display)"
    >
      {t("nav.brand", locale)}
    </a>

    <a
      href={altPath}
      class="text-sm font-medium text-slate-600 hover:text-teal-700 transition-colors"
      hreflang={altLocale}
      aria-label={`Switch language to ${altLabel}`}
    >
      {altLabel}
    </a>
  </div>
</nav>
