---
/**
 * Top navigation. Zero JS — desktop renders flat horizontal nav, mobile uses
 * native <details>/<summary> for the hamburger menu (accessible by default,
 * animates with CSS, dismissible).
 *
 * Active link highlighting: the current path's nav entry gets a bottom border
 * + darker text on desktop and a teal background pill on mobile. Computed at
 * build time from Astro.props.pathname; no runtime state.
 */
import { Icon } from "astro-icon/components";
import { localePath, SUPPORTED_LOCALES, type Locale } from "@/lib/seo";
import { t } from "@/i18n";

interface Props {
  locale: Locale;
  pathname: string;
  /** EN-only sections (e.g. /digest/) have no localized variants. When true,
   *  the language switcher points the other locales to their homepage instead
   *  of a non-existent localized path (avoids 404s + broken hreflang). */
  enOnly?: boolean;
}

const { locale, pathname, enOnly = false } = Astro.props;

// Native form (endonym) of each locale, shown in the language-switcher
// dropdown. Endonyms are the convention: each language is offered to the
// reader in its own script and spelling.
const localeNames: Record<Locale, string> = {
  en: "English",
  el: "Ελληνικά",
  de: "Deutsch",
  it: "Italiano",
  es: "Español",
};

const home = locale === "en" ? "/" : `/${locale}/`;
const prefix = locale === "en" ? "" : `/${locale}`;

// Two-tier nav: paths (Clinical audience entry) and library (the 6 collection
// indices). Visual separator between them. Active state matches if pathname
// starts with href. (Wellness entry removed in the Clinical/Wellness cleanup —
// it merged into /longevity/, which sits in the library tier below.)
const navLabels = {
  en: {
    clinical: "Clinical",
    indications: "Indications",
    departments: "Departments",
    longevity: "Longevity",
    evidence: "Evidence",
    references: "References",
  },
  el: {
    clinical: "Κλινικό",
    indications: "Ενδείξεις",
    departments: "Τμήματα",
    longevity: "Μακροζωία",
    evidence: "Τεκμηρίωση",
    references: "Βιβλιογραφία",
  },
  de: {
    clinical: "Klinisch",
    indications: "Indikationen",
    departments: "Fachbereiche",
    longevity: "Langlebigkeit",
    evidence: "Evidenz",
    references: "Quellen",
  },
  it: {
    clinical: "Clinico",
    indications: "Indicazioni",
    departments: "Reparti",
    longevity: "Longevità",
    evidence: "Evidenze",
    references: "Bibliografia",
  },
  es: {
    clinical: "Clínico",
    indications: "Indicaciones",
    departments: "Servicios",
    longevity: "Longevidad",
    evidence: "Evidencia",
    references: "Bibliografía",
  },
}[locale];

const paths = [
  { href: `${prefix}/clinical/`, label: navLabels.clinical },
];

const library = [
  { href: `${prefix}/mechanisms/`, label: t("mechanisms.section.title", locale).split(" ")[0] || "Mechanisms" },
  { href: `${prefix}/indications/`, label: navLabels.indications },
  { href: `${prefix}/departments/`, label: navLabels.departments },
  { href: `${prefix}/longevity/`, label: navLabels.longevity },
  { href: `${prefix}/evidence/`, label: navLabels.evidence },
  { href: `${prefix}/references/`, label: navLabels.references },
  // Research Digest is English-only content (locked decision): the link is the
  // same /digest/ path from every locale's chrome — no /<locale>/digest/.
  { href: "/digest/", label: t("nav.digest", locale) },
];

const allLinks = [...paths, ...library];

const isActive = (href: string): boolean => {
  // Exact match for / paths; prefix match (must be followed by /) for everything else
  if (href === "/" || href === "/el/" || href === "/de/" || href === "/it/" || href === "/es/") return pathname === href;
  return pathname === href || pathname.startsWith(href);
};
---

<nav class="border-b border-slate-200 bg-white sticky top-0 z-30">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
    <a
      href={home}
      class="flex-shrink-0 hover:opacity-80 transition-opacity"
      aria-label={t("nav.brand", locale)}
    >
      <img
        src="/brand/hbot-science-logo-horizontal.svg"
        alt={t("nav.brand", locale)}
        class="w-[140px] lg:w-[180px] h-auto"
        width="180"
        height="60"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    {/* Desktop nav (md+) */}
    <ul class="hidden lg:flex items-center gap-5 text-sm font-medium">
      {paths.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "transition-colors py-1 border-b-2",
              isActive(link.href)
                ? "text-teal-700 border-teal-700"
                : "text-slate-700 border-transparent hover:text-teal-700 hover:border-teal-200",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="text-slate-300" aria-hidden="true">|</li>
      {library.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "transition-colors py-1 border-b-2",
              isActive(link.href)
                ? "text-teal-700 border-teal-700"
                : "text-slate-700 border-transparent hover:text-teal-700 hover:border-teal-200",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    {/* Mobile menu (under lg) */}
    <details class="lg:hidden relative ml-auto">
      <summary
        class="list-none cursor-pointer p-2 -m-2 text-slate-700 hover:text-teal-700 transition-colors"
        aria-label={locale === "en" ? "Open menu" : locale === "el" ? "Άνοιγμα μενού" : "Menü öffnen"}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </summary>
      <ul
        class="absolute right-0 top-full mt-2 w-56 bg-white border border-slate-200 rounded-lg shadow-lg py-2 text-sm font-medium"
      >
        {allLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block px-4 py-2 transition-colors",
                isActive(link.href)
                  ? "bg-teal-50 text-teal-700"
                  : "text-slate-700 hover:bg-slate-50 hover:text-teal-700",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>

    {/* Site search trigger — opens the modal <dialog> below. The Pagefind
        JS/WASM/CSS bundle is lazy-loaded on first open (see the inline script
        after </nav>), so nothing search-related ships in the initial page
        payload — the zero-JS-on-load rule holds. */}
    <button
      type="button"
      id="search-trigger"
      class="flex-shrink-0 p-2 -m-2 text-slate-700 hover:text-teal-700 transition-colors flex items-center"
      aria-label={t("search.label", locale)}
      title={t("search.label", locale)}
      aria-haspopup="dialog"
    >
      <Icon name="lucide:search" class="w-5 h-5" />
    </button>

    {/* Language switcher: globe icon + dropdown.
        Replaces the per-locale link strip in Phase 7 — that pattern was
        already cramped at three locales and would not scale to IT/AR/etc.
        Native <details>/<summary> for the toggle, same zero-JS pattern as
        the mobile hamburger above. A small inline script supplements native
        behaviour with click-outside and Escape-to-close. */}
    <details class="language-switcher relative flex-shrink-0">
      <summary
        class="list-none cursor-pointer p-2 -m-2 text-slate-700 hover:text-teal-700 transition-colors flex items-center"
        aria-label={t("nav.changeLanguage", locale)}
        title={t("nav.changeLanguage", locale)}
      >
        <Icon name="lucide:globe" class="w-5 h-5" />
      </summary>
      <ul
        class="absolute right-0 top-full mt-2 w-44 bg-white border border-slate-200 rounded-lg shadow-lg py-2 text-sm font-medium z-40"
      >
        {SUPPORTED_LOCALES.map((l) => {
          const isCurrent = l === locale;
          return (
            <li>
              <a
                href={enOnly ? (isCurrent ? pathname : localePath("/", l)) : localePath(pathname, l)}
                hreflang={l}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  "flex items-center justify-between gap-2 px-4 py-2 transition-colors",
                  isCurrent
                    ? "text-teal-700 font-semibold bg-teal-50/50"
                    : "text-slate-700 hover:bg-slate-50 hover:text-teal-700",
                ]}
              >
                <span>{localeNames[l]}</span>
                {isCurrent && <Icon name="lucide:check" class="w-4 h-4 text-teal-700 flex-shrink-0" />}
              </a>
            </li>
          );
        })}
      </ul>
    </details>
  </div>
</nav>

{/* Search modal. Lazy-mounts the classic Pagefind UI into #search-ui on first
    open — no Pagefind JS/CSS ships in the initial payload. Native <dialog>
    (.showModal) provides focus trapping and Esc-to-close for free. */}
<dialog id="search-dialog" aria-labelledby="search-dialog-title">
  <div class="search-dialog-inner">
    <div class="search-dialog-header">
      <h2 id="search-dialog-title">{t("search.heading", locale)}</h2>
      <button type="button" id="search-close" aria-label={t("search.close", locale)}>
        <Icon name="lucide:x" class="w-5 h-5" />
      </button>
    </div>
    <div id="search-ui"></div>
  </div>
</dialog>

<script
  is:inline
  define:vars={{
    strings: {
      placeholder: t("search.placeholder", locale),
      clear: t("search.clear", locale),
      loadMore: t("search.loadMore", locale),
      label: t("search.label", locale),
      zeroResults: t("search.zeroResults", locale),
      oneResult: t("search.oneResult", locale),
      manyResults: t("search.manyResults", locale),
      searching: t("search.searching", locale),
    },
  }}
>
  // Site search. The Pagefind bundle (/pagefind/pagefind-ui.{js,css}) is
  // injected ONLY on first open — this small inline handler is the sole
  // search-related JS in the initial payload. Pagefind auto-scopes results to
  // the page's <html lang>, so each locale searches only its own pages.
  const trigger = document.getElementById("search-trigger");
  const dialog = document.getElementById("search-dialog");
  const closeBtn = document.getElementById("search-close");

  if (trigger && dialog && closeBtn) {
    let loaded = false;

    function loadPagefind() {
      if (loaded) return Promise.resolve();
      loaded = true;
      return new Promise((resolve, reject) => {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "/pagefind/pagefind-ui.css";
        document.head.appendChild(link);

        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        script.onload = () => {
          new window.PagefindUI({
            element: "#search-ui",
            showSubResults: true,
            showImages: false,
            resetStyles: false,
            autofocus: true,
            translations: {
              placeholder: strings.placeholder,
              clear_search: strings.clear,
              load_more: strings.loadMore,
              search_label: strings.label,
              zero_results: strings.zeroResults,
              one_result: strings.oneResult,
              many_results: strings.manyResults,
              searching: strings.searching,
            },
          });
          resolve();
        };
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    function focusInput() {
      requestAnimationFrame(() => {
        const input = dialog.querySelector(".pagefind-ui__search-input");
        if (input) input.focus();
      });
    }

    async function openSearch() {
      try {
        await loadPagefind();
      } catch (e) {
        return;
      }
      if (!dialog.open) dialog.showModal();
      focusInput();
    }

    trigger.addEventListener("click", openSearch);
    closeBtn.addEventListener("click", () => dialog.close());

    // Return focus to the trigger whenever the dialog closes (Esc, button,
    // backdrop) — required for A11y.
    dialog.addEventListener("close", () => trigger.focus());

    // Click on the backdrop (the <dialog> box itself, outside the inner panel)
    // closes the modal.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Keyboard: Cmd/Ctrl-K always opens; "/" opens only when not typing in a
    // form field (don't hijack "/" inside input/textarea/select/contentEditable).
    document.addEventListener("keydown", (e) => {
      if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        openSearch();
        return;
      }
      if (e.key === "/" && !dialog.open) {
        const el = document.activeElement;
        const tag = el && el.tagName;
        const editable =
          el &&
          (el.isContentEditable ||
            tag === "INPUT" ||
            tag === "TEXTAREA" ||
            tag === "SELECT");
        if (!editable) {
          e.preventDefault();
          openSearch();
        }
      }
    });
  }
</script>

<script is:inline>
  // Supplement native <details> behaviour: close on click-outside and Escape.
  // Native <details> only closes on summary toggle, which is not enough for a
  // dropdown UX. ~10 lines, no framework — runs once per page load.
  document.querySelectorAll("details.language-switcher").forEach((d) => {
    document.addEventListener("click", (e) => {
      if (d.open && !d.contains(e.target)) d.open = false;
    });
    d.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && d.open) {
        d.open = false;
        const s = d.querySelector("summary");
        if (s) s.focus();
      }
    });
  });
</script>

<style>
  /* Hide the default disclosure triangle on summary elements (hamburger + language switcher) */
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
</style>

<style is:global>
  /* Search modal. Global (not scoped) because Pagefind injects its result
     markup into #search-ui at runtime — those nodes carry no Astro scope
     hash. Selectors are namespaced under the search IDs/classes so nothing
     leaks. Pagefind UI is themed via its --pagefind-ui-* custom properties
     to match the site's teal palette. */
  #search-dialog {
    margin: 8vh auto auto;
    width: min(92vw, 640px);
    max-height: 80vh;
    padding: 0;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: 0 20px 50px -12px rgba(15, 23, 42, 0.35);
    overflow: hidden;
  }
  #search-dialog::backdrop {
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(2px);
  }
  .search-dialog-inner {
    display: flex;
    flex-direction: column;
    max-height: 80vh;
  }
  .search-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .search-dialog-header h2 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #334155;
  }
  #search-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    border-radius: 0.375rem;
    color: #64748b;
    cursor: pointer;
  }
  #search-close:hover {
    color: #0f766e;
    background: #f1f5f9;
  }
  #search-ui {
    padding: 1rem;
    overflow-y: auto;
    --pagefind-ui-primary: #0f766e;
    --pagefind-ui-text: #1e293b;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e2e8f0;
    --pagefind-ui-tag: #f1f5f9;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-font: inherit;
  }
</style>
