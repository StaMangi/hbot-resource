---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/lib/seo";
import type { CrossRef } from "@/lib/cross-links";
import { t } from "@/i18n";

interface Props {
  entry: CollectionEntry<"references">;
  locale: Locale;
  /** Entries that cite this reference. Phase 3.E reverse-index output. */
  citedBy?: CrossRef[];
  prefix?: string;
}
const { entry, locale, citedBy = [], prefix = "" } = Astro.props;

const typeBadge = (type: string) => {
  const tt = type.toLowerCase();
  if (
    tt.includes("rct") ||
    tt.includes("randomized controlled trial") ||
    tt.includes("review") ||
    tt.includes("meta-analysis")
  ) {
    return "bg-emerald-100 text-emerald-800";
  }
  if (tt.includes("guideline")) return "bg-violet-100 text-violet-800";
  return "bg-slate-100 text-slate-700";
};

const citedInLabel = locale === "en" ? "Cited in" : "Παραπέμπεται σε";
---

<li
  id={`ref-${entry.data.num}`}
  class="rounded-lg border border-slate-200 bg-white p-4 scroll-mt-20"
>
  <div class="flex flex-col sm:flex-row gap-4">
    <div class="flex sm:flex-col items-start gap-3 sm:w-12 flex-shrink-0">
      <div class="w-9 h-9 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center font-semibold text-sm">
        {entry.data.num}
      </div>
    </div>
    <div class="flex-1 min-w-0">
      <span
        class:list={[
          "inline-block px-2 py-0.5 text-xs font-medium rounded mb-2",
          typeBadge(entry.data.type),
        ]}
      >
        {entry.data.type}
      </span>
      <h3 class="text-sm font-semibold text-slate-900 leading-snug mb-1">
        {entry.data.title}
      </h3>
      <p class="text-xs text-slate-500">
        {entry.data.authors} · {entry.data.journal} · {entry.data.year}
      </p>
    </div>
    <div class="flex-shrink-0 self-start">
      <a
        href={entry.data.doi}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold border border-slate-200 hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800 transition-colors"
      >
        <Icon name="lucide:external-link" class="w-3 h-3" />
        <span>{t("refs.doi.label", locale)}</span>
      </a>
    </div>
  </div>

  {
    citedBy.length > 0 && (
      <div class="mt-3 pt-3 border-t border-slate-100 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
        <span class="font-semibold text-slate-500">{citedInLabel}:</span>
        {citedBy.map((c, i) => (
          <Fragment>
            <a
              href={`${prefix}/${c.collection}/${c.slug}/`}
              class="text-teal-700 underline underline-offset-2 hover:text-teal-800"
            >
              {c.title[locale]}
            </a>
            {i < citedBy.length - 1 && <span class="text-slate-300">·</span>}
          </Fragment>
        ))}
      </div>
    )
  }
</li>
