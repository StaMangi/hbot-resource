---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/lib/seo";

interface Props {
  entry: CollectionEntry<"indications">;
  locale: Locale;
  prefix?: string;
}
const { entry, locale, prefix = "" } = Astro.props;

const evidenceBadge = (level: string) =>
  level === "A"
    ? "bg-emerald-100 text-emerald-800 border-emerald-200"
    : level === "B"
      ? "bg-sky-100 text-sky-800 border-sky-200"
      : "bg-slate-100 text-slate-700 border-slate-200";
---

<a
  href={`${prefix}/indications/${entry.id}/`}
  class="group block rounded-xl bg-white border border-slate-200 hover:border-teal-300 hover:shadow-md transition-all p-6"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-emerald-100 text-emerald-800 font-bold text-sm flex-shrink-0">
      {entry.data.legacyId}
    </span>
    <span
      class:list={[
        "inline-block px-2.5 py-0.5 text-xs font-semibold rounded-md border",
        evidenceBadge(entry.data.evidenceLevel),
      ]}
    >
      Level {entry.data.evidenceLevel}
    </span>
  </div>

  <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">
    {entry.data.category[locale]}
  </p>
  <h3
    class="text-base font-semibold text-slate-900 leading-snug group-hover:text-teal-700 transition-colors"
    style="font-family: var(--font-display)"
  >
    {entry.data.condition[locale]}
  </h3>

  <p class="mt-2 text-sm text-slate-600 leading-relaxed line-clamp-3">
    {entry.data.description[locale]}
  </p>

  <div class="mt-3 flex items-center gap-1.5 text-xs text-emerald-700">
    <Icon name="lucide:check-circle-2" class="w-3.5 h-3.5" />
    <span>{entry.data.evidence[locale]}</span>
  </div>
</a>
