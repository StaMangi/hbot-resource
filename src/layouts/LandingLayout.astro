---
/**
 * LandingLayout — for the three tier 1 + tier 2 pages: /, /clinical/, /wellness/.
 *
 * Visually distinguished from IndexLayout/DetailLayout by allowing a full-bleed
 * hero section above the main content. Inside the hero slot, components can
 * use whatever gradient/imagery the page brand calls for.
 *
 * Wraps BaseLayout — inherits Nav, Footer, and full SEO scaffolding.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import type { Locale } from "@/lib/seo";

export interface Props {
  title: string;
  description?: string;
  locale: Locale;
  pathname: string;
  ogImage?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <Nav slot="nav" locale={props.locale} pathname={props.pathname} />
  <Footer slot="footer" locale={props.locale} pathname={props.pathname} />

  <slot name="hero" />
  <slot />
</BaseLayout>
