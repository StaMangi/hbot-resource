---
/**
 * DetailLayout — for individual entry pages (/indications/[slug]/, /mechanisms/[slug]/, etc.).
 *
 * Two-column layout on desktop, single-column on mobile. Main column holds the
 * entry content; aside column holds cross-links ("Related" entries computed
 * from the build-time reverse index in src/lib/cross-links.ts).
 *
 * Phase 3.E: breadcrumbs are now passed as a prop rather than via slot. The
 * same array drives both the visible <Breadcrumbs /> trail at the top of the
 * article AND the BreadcrumbList JSON-LD emitted by BaseHead.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import type { Locale } from "@/lib/seo";
import type { BreadcrumbItem } from "@/lib/breadcrumbs";

export interface Props {
  title: string;
  description?: string;
  locale: Locale;
  pathname: string;
  ogImage?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;

  /** Breadcrumb trail. Drives both the visible trail and BreadcrumbList JSON-LD. */
  breadcrumbs?: BreadcrumbItem[];
  /** Visible page heading (h1). Distinct from the document <title>. */
  pageHeading: string;
  /** Optional eyebrow text above h1 (e.g. category label). */
  eyebrow?: string;
}

const { pageHeading, eyebrow, breadcrumbs, ...baseProps } = Astro.props;
---

<BaseLayout {...baseProps} breadcrumbs={breadcrumbs}>
  <Nav slot="nav" locale={baseProps.locale} pathname={baseProps.pathname} />
  <Footer slot="footer" locale={baseProps.locale} pathname={baseProps.pathname} />

  <article class="py-12 md:py-16 max-w-6xl mx-auto px-6">
    {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}

    <header class="mb-10 max-w-3xl">
      {
        eyebrow && (
          <p class="text-xs uppercase tracking-widest text-slate-500 mb-2">
            {eyebrow}
          </p>
        )
      }
      <h1
        class="text-3xl md:text-4xl font-semibold text-slate-900 leading-tight"
        style="font-family: var(--font-display)"
      >
        {pageHeading}
      </h1>
    </header>

    <div class="grid lg:grid-cols-[1fr_18rem] gap-10">
      <main class="min-w-0">
        <slot />
      </main>

      <aside class="space-y-6">
        <slot name="aside" />
      </aside>
    </div>
  </article>
</BaseLayout>
