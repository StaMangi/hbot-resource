---
/**
 * Research Digest archive — /digest/
 *
 * English-only section (locked decision): renders with locale="en" and
 * enOnly so BaseHead emits no el/de/it hreflang and the Nav switcher points
 * other locales to their homepage rather than a non-existent /<locale>/digest/.
 */
import { getCollection } from "astro:content";
import IndexLayout from "@/layouts/IndexLayout.astro";
import SubscribeForm from "@/components/SubscribeForm.astro";
import { t } from "@/i18n";

const pathname = Astro.url.pathname;
const locale = "en" as const;

const issues = (await getCollection("digest")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t("digest.archive.title", locale),
  description: t("digest.archive.subtitle", locale),
  inLanguage: "en",
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<IndexLayout
  title={`${t("digest.archive.title", locale)} — HBOT Science`}
  description={t("digest.archive.subtitle", locale)}
  locale={locale}
  pathname={pathname}
  enOnly={true}
  jsonLd={jsonLd}
  badge={t("digest.archive.badge", locale)}
  pageHeading={t("digest.archive.title", locale)}
  pageSubtitle={t("digest.archive.subtitle", locale)}
  badgeColor="teal"
>
  <div class="mb-10">
    <SubscribeForm locale={locale} />
  </div>

  {
    issues.length === 0 ? (
      <p class="text-sm text-slate-500">{t("digest.archive.empty", locale)}</p>
    ) : (
      <ul class="space-y-4">
        {issues.map((issue) => (
          <li>
            <a
              href={`/digest/${issue.id}/`}
              class="group block rounded-xl border border-slate-200 bg-white p-5 transition-colors hover:border-teal-300 hover:bg-teal-50/30"
            >
              <p class="text-xs uppercase tracking-wider text-slate-500">
                {fmtDate(issue.data.date)}
              </p>
              <h2
                class="mt-1 text-lg font-semibold text-slate-900 group-hover:text-teal-700"
                style="font-family: var(--font-display)"
              >
                {issue.data.title}
              </h2>
              <p class="mt-1 text-sm text-slate-500">
                {issue.data.items.length} {t("digest.issue.itemsLabel", locale)}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</IndexLayout>
