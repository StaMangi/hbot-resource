---
/**
 * Individual digest issue — /digest/<slug>/ (e.g. /digest/2026-w22/)
 *
 * English-only (locked decision): locale="en" + enOnly. Each item links out
 * to the source (DOI/URL) with a 1–2 sentence plain-language summary.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { t } from "@/i18n";

const locale = "en" as const;

export async function getStaticPaths() {
  const issues = await getCollection("digest");
  return issues.map((issue) => ({ params: { slug: issue.id }, props: { issue } }));
}

interface Props {
  issue: CollectionEntry<"digest">;
}
const { issue } = Astro.props;
const pathname = Astro.url.pathname;

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: issue.data.title,
  datePublished: issue.data.date.toISOString(),
  inLanguage: "en",
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<IndexLayout
  title={`${issue.data.title} — HBOT Science`}
  description={`HBOT research digest — ${fmtDate(issue.data.date)}`}
  locale={locale}
  pathname={pathname}
  enOnly={true}
  jsonLd={jsonLd}
  badge={t("digest.archive.badge", locale)}
  pageHeading={issue.data.title}
  pageSubtitle={`${fmtDate(issue.data.date)} · ${issue.data.items.length} ${t("digest.issue.itemsLabel", locale)}`}
  badgeColor="teal"
>
  <ol class="space-y-5">
    {
      issue.data.items.map((item) => (
        <li class="rounded-xl border border-slate-200 bg-white p-5">
          <h2 class="text-base font-semibold text-slate-900 leading-snug">
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-teal-700"
            >
              {item.title}
              <Icon
                name="lucide:external-link"
                class="inline w-3.5 h-3.5 ml-1 align-baseline text-slate-400"
              />
            </a>
          </h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">{item.summary}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-10 border-t border-slate-200 pt-6">
    <a
      href="/digest/"
      class="text-sm font-medium text-teal-700 hover:text-teal-800"
    >
      ← {t("digest.archive.title", locale)}
    </a>
  </div>
</IndexLayout>
