---
import LandingLayout from "@/layouts/LandingLayout.astro";
import StubContent from "@/components/StubContent.astro";

const pathname = Astro.url.pathname;
---

<LandingLayout
  title="Για κέντρα ευεξίας και μακροζωίας — HBOT Science"
  description="HBOT για προγράμματα ευεξίας και μακροζωίας — αποτελέσματα, σχεδιασμός εμπειρίας μέλους, πρωτόκολλα προγραμμάτων και αρχιτεκτονική αναφοράς για operators."
  locale="el"
  pathname={pathname}
  noindex={true}
>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <p class="text-xs uppercase tracking-widest text-slate-500">Για κέντρα ευεξίας & μακροζωίας</p>
    <h1 class="mt-3 text-4xl font-semibold text-slate-900" style="font-family: var(--font-display)">
      Ευεξία & Μακροζωία
    </h1>
    <StubContent phase="3.B" locale="el" />
  </section>
</LandingLayout>
