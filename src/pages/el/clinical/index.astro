---
import { Icon } from "astro-icon/components";
import LandingLayout from "@/layouts/LandingLayout.astro";
import { SITE_NAME } from "@/lib/seo";

const pathname = Astro.url.pathname;
const locale = "el" as const;

const title = `Κλινική Ενσωμάτωση — ${SITE_NAME}`;
const description =
  "HBOT για νοσοκομεία και κλινικές — εγκεκριμένες ενδείξεις FDA, επίπεδα τεκμηρίωσης, χαρτογράφηση εφαρμογών ανά τμήμα, πρωτόκολλα και στρατηγικές συστάσεις.";

const libraryLinks = [
  { href: "/el/indications/", icon: "lucide:list-checks", title: "Εγκεκριμένες Ενδείξεις FDA", body: "Και οι 14 παθήσεις αναγνωρισμένες από την UHMS, με επίπεδα τεκμηρίωσης και πρωτόκολλα." },
  { href: "/el/evidence/", icon: "lucide:book-open", title: "Επιστημονική Τεκμηρίωση", body: "Αξιολογημένα RCT και μετα-αναλύσεις σε κλινικές ειδικότητες." },
  { href: "/el/protocols/", icon: "lucide:gauge", title: "Σύγκριση Πρωτοκόλλων", body: "Συγκριτικός πίνακας πρωτοκόλλων — πίεση, συνεδρίες, διάρκεια, συχνότητα." },
  { href: "/el/safety/", icon: "lucide:shield-alert", title: "Ασφάλεια & Αντενδείξεις", body: "Απόλυτες και σχετικές αντενδείξεις, ανεπιθύμητες ενέργειες, λίστα ελέγχου." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "el",
  description,
  audience: { "@type": "MedicalAudience", audienceType: "MedicalProfessional" },
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title={title}
  description={description}
  locale={locale}
  pathname={pathname}
  ogType="website"
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="bg-gradient-to-br from-teal-50 via-white to-slate-50">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
      <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-100 text-teal-800">
        Για νοσοκομεία & κλινικές
      </span>
      <h1
        class="mt-4 text-4xl md:text-5xl font-bold text-slate-900 leading-tight max-w-3xl"
        style="font-family: var(--font-display)"
      >
        Κλινική ενσωμάτωση Υπερβαρικής Οξυγονοθεραπείας
      </h1>
      <p class="mt-5 text-lg text-slate-600 leading-relaxed max-w-3xl">
        Εγκεκριμένες ενδείξεις FDA, επίπεδα τεκμηρίωσης, χαρτογράφηση εφαρμογών
        ανά τμήμα, πρωτόκολλα και στρατηγικές συστάσεις για την ενσωμάτωση
        υπηρεσιών HBOT σε ένα νοσοκομειακό πρόγραμμα.
      </p>
    </div>
  </section>

  {/* Department mapping — teaser (the full twelve-card grid lives on /el/departments/) */}
  <section class="max-w-6xl mx-auto px-6 pt-8 pb-16 md:pt-10 md:pb-20">
    <div class="max-w-2xl">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900"
        style="font-family: var(--font-display)"
      >
        Χαρτογράφηση ανά τμήμα
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Δώδεκα κλινικές ειδικότητες έχουν τεκμηριωμένες εφαρμογές HBOT. Κάθε
        τμήμα διαθέτει τη δική του σελίδα με την πλήρη λίστα εγκεκριμένων από τον
        FDA και ερευνητικού σταδίου ενδείξεων, πρωτοκόλλων και βιβλιογραφίας.
      </p>
      <p class="mt-6">
        <a href="/el/departments/" class="text-teal-700 underline underline-offset-2 hover:text-teal-800 font-semibold">Όλα τα τμήματα →</a>
      </p>
    </div>
  </section>

  {/* Library quick-links */}
  <section class="bg-slate-50 py-16 md:py-20 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-6">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900 mb-10"
        style="font-family: var(--font-display)"
      >
        Υλικό αναφοράς
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          libraryLinks.map((link) => (
            <a
              href={link.href}
              class="group block rounded-xl border border-slate-200 bg-white p-5 hover:border-teal-300 hover:shadow-sm transition-all"
            >
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center flex-shrink-0 group-hover:bg-teal-100 group-hover:text-teal-700 transition-colors">
                  <Icon name={link.icon} class="w-5 h-5" />
                </div>
                <div class="min-w-0">
                  <h3
                    class="text-base font-semibold text-slate-900 group-hover:text-teal-700 transition-colors"
                    style="font-family: var(--font-display)"
                  >
                    {link.title}
                  </h3>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{link.body}</p>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</LandingLayout>
