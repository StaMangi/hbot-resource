---
import LandingLayout from "@/layouts/LandingLayout.astro";
import StubContent from "@/components/StubContent.astro";

const pathname = Astro.url.pathname;
---

<LandingLayout
  title="Για νοσοκομεία και κλινικές — HBOT Science"
  description="Ενσωμάτωση HBOT για νοσοκομεία και κλινικές — επίπεδα τεκμηρίωσης, χαρτογράφηση εφαρμογών ανά τμήμα, εγκεκριμένες ενδείξεις FDA και πρωτόκολλα."
  locale="el"
  pathname={pathname}
  noindex={true}
>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <p class="text-xs uppercase tracking-widest text-slate-500">Για νοσοκομεία & κλινικές</p>
    <h1 class="mt-3 text-4xl font-semibold text-slate-900" style="font-family: var(--font-display)">
      Κλινική Ενσωμάτωση
    </h1>
    <StubContent phase="3.B" locale="el" />
  </section>
</LandingLayout>
