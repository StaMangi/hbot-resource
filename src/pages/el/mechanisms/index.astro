---
import IndexLayout from "@/layouts/IndexLayout.astro";
import StubContent from "@/components/StubContent.astro";
import { t } from "@/i18n";

const pathname = Astro.url.pathname;
const locale = "el" as const;
---

<IndexLayout
  title={`${t("mechanisms.section.title", locale)} — HBOT Science`}
  description={t("mechanisms.section.subtitle", locale)}
  locale={locale}
  pathname={pathname}
  badge={t("mechanisms.section.badge", locale)}
  pageHeading={t("mechanisms.section.title", locale)}
  pageSubtitle={t("mechanisms.section.subtitle", locale)}
  badgeColor="teal"
  noindex={true}
>
  <StubContent phase="3.C" locale={locale} />
</IndexLayout>
