---
import LandingLayout from "@/layouts/LandingLayout.astro";

const pathname = Astro.url.pathname;
const locale = "el" as const;

const description =
  "Συντακτικά πρότυπα, πλαίσιο τεκμηρίωσης, ενημέρωση εκδότη, διαδικασία διορθώσεων και όρια πεδίου εφαρμογής για το HBOT Science — ανεξάρτητη πηγή αναφοράς για την υπερβαρική θεραπεία οξυγόνου.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Σχετικά με το HBOT Science",
  description,
  inLanguage: locale,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title="Σχετικά — HBOT Science"
  description={description}
  locale={locale}
  pathname={pathname}
  jsonLd={jsonLd}
>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <p class="text-xs uppercase tracking-widest text-slate-500">Εκδοτική πολιτική</p>
    <h1
      class="mt-3 text-4xl font-semibold text-slate-900"
      style="font-family: var(--font-display)"
    >
      Σχετικά με το HBOT Science
    </h1>
    <p class="mt-4 text-lg text-slate-700 leading-relaxed">
      Το HBOT Science είναι ανεξάρτητη πηγή αναφοράς για την υπερβαρική
      θεραπεία οξυγόνου. Συγκεντρώνει τεκμηριωμένες πληροφορίες για τις
      εγκεκριμένες ενδείξεις FDA, τις αναδυόμενες κλινικές εφαρμογές, τους
      μηχανισμούς δράσης, τα πρωτόκολλα θεραπείας και τις παραμέτρους
      ασφάλειας — για κλινικούς ιατρούς, ερευνητές και ενημερωμένους
      αναγνώστες.
    </p>
    <p class="mt-4 text-lg text-slate-700 leading-relaxed">
      Ο ιστότοπος δεν παρέχει ιατρικές συμβουλές, εξατομικευμένες
      θεραπευτικές συστάσεις ή εμπορικές προωθήσεις. Είναι επιστημονική
      πηγή αναφοράς — όχι κλινική, όχι κατάλογος παρόχων, όχι κανάλι
      μάρκετινγκ.
    </p>

    <section class="mt-12">
      <h2
        class="text-2xl font-semibold text-slate-900 mb-4"
        style="font-family: var(--font-display)"
      >
        Συντακτικά πρότυπα
      </h2>
      <p class="text-slate-700 mb-3">
        Κάθε ισχυρισμός στον ιστότοπο τεκμηριώνεται από peer-reviewed πηγή ή
        αναγνωρισμένη κλινική αρχή (UHMS, Cochrane, FDA, κατευθυντήριες
        οδηγίες επαγγελματικών εταιρειών). Οι παραπομπές επαληθεύονται κατά
        τη δημιουργία του ιστότοπου έναντι του μητρώου DOI της CrossRef —
        σπασμένες ή πλασματικές παραπομπές δεν μπορούν να δημοσιευθούν.
      </p>
      <p class="text-slate-700 mb-3">
        Τα ποσοτικά στοιχεία (μεγέθη επίδρασης, αριθμοί δείγματος,
        διάρκειες) αναπαράγονται απευθείας από την αναφερόμενη πηγή. Δεν
        παραφράζουμε αριθμούς, δεν στρογγυλοποιούμε ποσοστά, δεν
        συνοψίζουμε αποτελέσματα με τρόπο που χάνει τις υποκείμενες
        επιφυλάξεις.
      </p>
      <p class="text-slate-700 mb-3">
        Όπου τα στοιχεία είναι προκαταρκτικά, μονής πηγής ή αμφιλεγόμενα, ο
        ιστότοπος το δηλώνει ευθέως. Χρησιμοποιούμε τριεπίπεδο πλαίσιο
        τεκμηρίωσης — Επίπεδο A (πολλαπλές υψηλής ποιότητας ΤΕΔ ή
        συστηματικές ανασκοπήσεις), Επίπεδο B (μία ισχυρή ΤΕΔ ή συνεπή
        μετα-αναλυτικά στοιχεία), Επίπεδο C (στοιχεία επιπέδου περιπτώσεων,
        μικρών ομάδων ή μεταφραστικά). Οι ερευνητικές χρήσεις
        χαρακτηρίζονται ρητά ως ερευνητικές. Ισχυρισμοί χωρίς επαρκή
        τεκμηρίωση δεν διατυπώνονται καθόλου.
      </p>
    </section>

    <section class="mt-12">
      <h2
        class="text-2xl font-semibold text-slate-900 mb-4"
        style="font-family: var(--font-display)"
      >
        Πλαίσιο τεκμηρίωσης
      </h2>
      <p class="text-slate-700 mb-3">
        Ο ιστότοπος οργανώνει τις ενδείξεις της HBOT σε δύο επίπεδα που
        αντικατοπτρίζουν διαφορετικές βάσεις τεκμηρίωσης.
      </p>
      <p class="text-slate-700 mb-3">
        <strong>Εγκεκριμένες ενδείξεις FDA</strong> είναι οι δεκατέσσερις
        παθήσεις που αναγνωρίζονται από την Undersea and Hyperbaric Medical
        Society (UHMS) και καλύπτονται από τα Medicare και Medicaid στις
        Ηνωμένες Πολιτείες ως καθιερωμένη ή επικουρική θεραπεία. Κάθε μία
        υποστηρίζεται από Επίπεδο A ή B τεκμηρίωση. Τα θεραπευτικά
        πρωτόκολλα για αυτές τις παθήσεις είναι καλά εδραιωμένα και
        κλινικά επαληθευμένα.
      </p>
      <p class="text-slate-700 mb-3">
        <strong>Αναδυόμενες ενδείξεις</strong> είναι παθήσεις όπου τα
        peer-reviewed κλινικά στοιχεία υποστηρίζουν την ερευνητική χρήση της
        HBOT, αλλά όπου η τεκμηρίωση δεν πληροί ακόμη τα κριτήρια για
        έγκριση από FDA ή αναγνώριση από UHMS. Συνήθως υποστηρίζονται από
        Επίπεδο B ή C τεκμηρίωση — μεμονωμένες ερευνητικές ομάδες που
        αναμένουν ανεξάρτητη επιβεβαίωση, πιλοτικές μελέτες που αναμένουν
        πλήρεις δοκιμές, ή στοιχεία επιπέδου περιπτώσεων σε καθορισμένες
        υποομάδες ασθενών. Παρουσιάζονται για κλινικό πλαίσιο. Οι
        θεραπευτικές αποφάσεις που αφορούν αναδυόμενες ενδείξεις απαιτούν
        εξατομικευμένη αξιολόγηση του ασθενούς και δεν αποτελούν
        καθιερωμένη πρακτική.
      </p>
    </section>

    <section class="mt-12">
      <h2
        class="text-2xl font-semibold text-slate-900 mb-4"
        style="font-family: var(--font-display)"
      >
        Εκδότης
      </h2>
      <p class="text-slate-700 mb-3">
        Το HBOT Science εκδίδεται από την IN2050 Ltd, εταιρεία εγγεγραμμένη
        στην Κύπρο (HE416406) που δραστηριοποιείται στον τομέα της
        φιλοξενίας ευεξίας. Η IN2050 έχει εμπορικά συμφέροντα σε υπηρεσίες
        HBOT. Οι συντακτικές αποφάσεις του ιστότοπου λαμβάνονται ανεξάρτητα
        από αυτά τα εμπορικά συμφέροντα.
      </p>
    </section>

    <section class="mt-12">
      <h2
        class="text-2xl font-semibold text-slate-900 mb-4"
        style="font-family: var(--font-display)"
      >
        Διορθώσεις και ενημερώσεις
      </h2>
      <p class="text-slate-700 mb-3">
        Σφάλματα γεγονότων, παραπομπών ή ερμηνείας διορθώνονται όταν
        εντοπίζονται. Σημαντικές διορθώσεις σημειώνονται στη σχετική
        σελίδα και στο ιστορικό commits του ιστότοπου, το οποίο είναι
        δημόσια προσβάσιμο. Μικρές επεξεργασίες (τυπογραφία, ορθογραφία,
        μορφοποίηση) εφαρμόζονται χωρίς ειδοποίηση.
      </p>
      <p class="text-slate-700 mb-3">
        Ο ιστότοπος ενημερώνεται καθώς γίνονται διαθέσιμα νέα peer-reviewed
        στοιχεία. Οι ενδείξεις μπορούν να μετακινηθούν μεταξύ επιπέδων
        τεκμηρίωσης καθώς τα στοιχεία ενισχύονται ή νέες δοκιμές
        δημοσιεύουν αποτελέσματα. Όπου το συντακτικό πλαίσιο μιας ένδειξης
        αλλάζει ουσιωδώς, η αλλαγή αποτυπώνεται στο ιστορικό commits.
      </p>
      <p class="text-slate-700 mb-3">
        Για αναφορά σφάλματος ή πρόταση διόρθωσης, επικοινωνία:
        <a
          href="mailto:info@hbotscience.org"
          class="text-teal-700 underline underline-offset-2 hover:text-teal-800"
          >info@hbotscience.org</a
        >
      </p>
    </section>

    <section class="mt-12">
      <h2
        class="text-2xl font-semibold text-slate-900 mb-4"
        style="font-family: var(--font-display)"
      >
        Πεδίο εφαρμογής και όρια
      </h2>
      <p class="text-slate-700 mb-3">
        Ο ιστότοπος παρέχει πληροφορίες αναφοράς για την υπερβαρική θεραπεία
        οξυγόνου. Δεν:
      </p>
      <ul class="list-disc pl-6 text-slate-700 space-y-2">
        <li>Παρέχει εξατομικευμένες ιατρικές συμβουλές ή θεραπευτικές συστάσεις.</li>
        <li>Διαγιγνώσκει παθήσεις ούτε υποκαθιστά την κλινική αξιολόγηση από εξειδικευμένο επαγγελματία υγείας.</li>
        <li>Συνιστά, προωθεί ή συγκρίνει συγκεκριμένους παρόχους HBOT, κλινικές ή προϊόντα.</li>
        <li>Παρέχει τιμολόγηση, εμπορικές πληροφορίες ή καθοδήγηση για πρόσβαση σε θεραπεία.</li>
        <li>Παρέχει νομικές συμβουλές για τη ρύθμιση, αδειοδότηση ή συμμόρφωση HBOT.</li>
        <li>Παρέχει καθοδήγηση για ασφάλιση ή αποζημίωση.</li>
        <li>Παρέχει συμβουλές για την έναρξη, λειτουργία ή σχεδιασμό εγκαταστάσεων HBOT.</li>
      </ul>
      <p class="mt-4 text-slate-700">
        Οι ασθενείς που αναζητούν HBOT για οποιαδήποτε ένδειξη θα πρέπει να
        συμβουλεύονται εξειδικευμένο ιατρό ή ειδικό υπερβαρικής ιατρικής.
        Οι θεραπευτικές αποφάσεις απαιτούν αξιολόγηση του ατομικού ιατρικού
        ιστορικού, των συνοδών παθήσεων και της παράλληλης φαρμακευτικής
        αγωγής.
      </p>
    </section>
  </article>
</LandingLayout>
