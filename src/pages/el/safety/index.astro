---
import LandingLayout from "@/layouts/LandingLayout.astro";
import StubContent from "@/components/StubContent.astro";

const pathname = Astro.url.pathname;
const locale = "el" as const;
---

<LandingLayout
  title="Ασφάλεια & Αντενδείξεις — HBOT Science"
  description="Απόλυτες και σχετικές αντενδείξεις, ανεπιθύμητες ενέργειες και διαχείριση, λίστα ελέγχου ασθενών για HBOT."
  locale={locale}
  pathname={pathname}
  noindex={true}
>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <p class="text-xs uppercase tracking-widest text-slate-500">Αναφορά</p>
    <h1 class="mt-3 text-4xl font-semibold text-slate-900" style="font-family: var(--font-display)">
      Ασφάλεια & Αντενδείξεις
    </h1>
    <StubContent phase="4" locale={locale} />
  </section>
</LandingLayout>
