---
import LandingLayout from "@/layouts/LandingLayout.astro";
import StubContent from "@/components/StubContent.astro";

const pathname = Astro.url.pathname;
const locale = "el" as const;
---

<LandingLayout
  title="Σχεδιασμός 60 Συνεδριών — HBOT Science"
  description="Σχεδιασμός εμπειρίας μέλους για προγράμματα HBOT μακροζωίας — αξιολόγηση, ρυθμός πρωτοκόλλου, παρακολούθηση βιοδεικτών, συνδυασμός με συμπληρωματικές μεθόδους, φάση συντήρησης."
  locale={locale}
  pathname={pathname}
  noindex={true}
>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <p class="text-xs uppercase tracking-widest text-slate-500">Αναφορά operator</p>
    <h1 class="mt-3 text-4xl font-semibold text-slate-900" style="font-family: var(--font-display)">
      Σχεδιασμός 60 Συνεδριών
    </h1>
    <StubContent phase="4" locale={locale} />
  </section>
</LandingLayout>
