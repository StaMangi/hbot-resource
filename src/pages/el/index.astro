---
import { getCollection } from "astro:content";
import LandingLayout from "@/layouts/LandingLayout.astro";
import HomeStat from "@/components/HomeStat.astro";
import HomePathCard from "@/components/HomePathCard.astro";
import HomeLibraryTile from "@/components/HomeLibraryTile.astro";
import { SITE_NAME } from "@/lib/seo";
import { t } from "@/i18n";

const pathname = Astro.url.pathname;
const locale = "el" as const;

const title = `${SITE_NAME} — Τεκμηριωμένος Οδηγός HBOT`;
const description =
  "Τεκμηριωμένος οδηγός υπερβαρικής οξυγονοθεραπείας. Μηχανισμοί, εγκεκριμένες ενδείξεις FDA, κλινικά πρωτόκολλα, εφαρμογές μακροζωίας και αξιολογημένη βιβλιογραφία.";

const indications = await getCollection("indications");
const fdaCount = indications.filter((e) => e.data.tier === "fda-approved").length;
const emergingCount = indications.filter((e) => e.data.tier === "emerging").length;
const totalIndications = fdaCount + emergingCount;

const stats = [
  { value: String(fdaCount), label: t("stat.fda.label", locale), sub: t("stat.fda.sub", locale) },
  { value: ">20%", label: t("stat.telomere.label", locale), sub: t("stat.telomere.sub", locale) },
  { value: "258", label: t("stat.citations.label", locale), sub: t("stat.citations.sub", locale) },
  { value: "2.0–3.0 ATA", label: t("stat.pressure.label", locale), sub: t("stat.pressure.sub", locale) },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "el",
  description,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title={title}
  description={description}
  locale={locale}
  pathname={pathname}
  ogType="website"
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-teal-50/40">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-100 text-teal-800">
          Τεκμηριωμένος Οδηγός HBOT
        </span>
        <h1
          class="mt-5 text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 leading-tight"
          style="font-family: var(--font-display)"
        >
          Η <span class="text-teal-700">επιστημονική αναφορά</span> για την
          υπερβαρική οξυγονοθεραπεία.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-slate-600 leading-relaxed">
          Μηχανισμοί, εγκεκριμένες ενδείξεις FDA, κλινικά πρωτόκολλα, εφαρμογές
          μακροζωίας και αξιολογημένη βιβλιογραφία. Χωρίς marketing, χωρίς
          chatbot — μόνο όσα υποστηρίζει η βιβλιογραφία.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-10 max-w-4xl">
        {stats.map((s) => <HomeStat {...s} />)}
      </div>
    </div>
  </section>

  {/* Two soft-routing path cards */}
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900"
        style="font-family: var(--font-display)"
      >
        Δύο διαδρομές, μία τεκμηρίωση
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Νοσοκομεία και κέντρα μακροζωίας προσεγγίζουν την HBOT από διαφορετικές
        γωνίες — αλλά η υποκείμενη επιστήμη είναι κοινή. Επιλέξτε τη διαδρομή
        που ταιριάζει στην ερώτησή σας.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <HomePathCard
        href="/el/clinical/"
        icon="lucide:stethoscope"
        eyebrow="Για νοσοκομεία & κλινικές"
        title="Κλινική Ενσωμάτωση"
        body="Εγκεκριμένες ενδείξεις FDA, επίπεδα τεκμηρίωσης, χαρτογράφηση εφαρμογών ανά τμήμα, πρωτόκολλα και στρατηγικές συστάσεις για νοσοκομειακή ενσωμάτωση."
        cta="Εξερεύνηση κλινικού"
        variant="clinical"
      />
      <HomePathCard
        href="/el/wellness/"
        icon="lucide:sparkles"
        eyebrow="Για κέντρα ευεξίας & μακροζωίας"
        title="Ευεξία & Μακροζωία"
        body="Επιμήκυνση τελομερών, μείωση γηρασμένων κυττάρων, γνωστική ενίσχυση, αθλητική αποκατάσταση — πρωτόκολλα, τεκμηρίωση και αρχιτεκτονική αναφοράς."
        cta="Εξερεύνηση ευεξίας"
        variant="wellness"
      />
    </div>
  </section>

  {/* Shared library preview */}
  <section class="bg-slate-50 py-16 md:py-20 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <h2
          class="text-2xl md:text-3xl font-semibold text-slate-900"
          style="font-family: var(--font-display)"
        >
          Βιβλιοθήκη αναφοράς
        </h2>
        <p class="mt-3 text-slate-600 leading-relaxed">
          Το ίδιο υλικό πηγής, οργανωμένο για άμεση αναζήτηση. Συνδέεται από τις
          δύο διαδρομές παραπάνω και από κάθε σελίδα λεπτομερειών στον ιστότοπο.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <HomeLibraryTile
          href="/el/mechanisms/"
          icon="lucide:atom"
          title="Μηχανισμοί Δράσης"
          body="Πέντε φυσιολογικοί μηχανισμοί — υπεροξυγόνωση, αγγειογένεση, αντιμικροβιακή δράση, μείωση όγκου αερίου, αντιγηραντικά μονοπάτια."
        />
        <HomeLibraryTile
          href="/el/indications/"
          icon="lucide:list-checks"
          title="Ενδείξεις"
          body={`${totalIndications} ενδείξεις σε δύο επίπεδα τεκμηρίωσης — ${fdaCount} εγκεκριμένες FDA (αναγνωρισμένες από UHMS) και ${emergingCount} αναδυόμενες — με επίπεδα τεκμηρίωσης, πρωτόκολλα και βασικές αναφορές.`}
        />
        <HomeLibraryTile
          href="/el/evidence/"
          icon="lucide:book-open"
          title="Επιστημονική Τεκμηρίωση"
          body="Αξιολογημένα RCT, μετα-αναλύσεις και προοπτικές μελέτες — DOI σύνδεσμοι σε δημοσιεύσεις."
        />
        <HomeLibraryTile
          href="/el/references/"
          icon="lucide:bookmark"
          title="Βιβλιογραφία"
          body="Όλες οι πηγές που αναφέρονται με άμεσους συνδέσμους. Η ραχοκοκαλιά τεκμηρίωσης για κάθε ισχυρισμό στον ιστότοπο."
        />
      </div>
    </div>
  </section>
</LandingLayout>
