---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_NAME } from "@/lib/seo";

const title = `${SITE_NAME} — Τεκμηριωμένος Οδηγός Υπερβαρικής Οξυγονοθεραπείας`;
const description =
  "Τεκμηριωμένος οδηγός υπερβαρικής οξυγονοθεραπείας. Μηχανισμοί, εγκεκριμένες ενδείξεις FDA, κλινικά πρωτόκολλα, εφαρμογές μακροζωίας και αξιολογημένη βιβλιογραφία.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "el",
  description,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: {
      "@type": "PostalAddress",
      addressCountry: "CY",
    },
    identifier: "HE416406",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  locale="el"
  pathname="/el/"
  ogType="website"
  jsonLd={jsonLd}
  noindex={true}
>
  <section class="max-w-3xl mx-auto px-6 py-24">
    <p class="text-sm uppercase tracking-widest text-slate-500">Φάση 2.A — Εκκίνηση</p>
    <h1 class="mt-4 text-4xl font-semibold text-slate-900" style="font-family: var(--font-display)">
      HBOT Resource
    </h1>
    <p class="mt-6 text-lg text-slate-700">
      Τεκμηριωμένος οδηγός υπερβαρικής οξυγονοθεραπείας. Βασικό κέλυφος Astro —
      η μεταφορά περιεχομένου ακολουθεί στο υποβήμα 2.B.
    </p>
    <p class="mt-4 text-sm text-slate-500">
      Εκδότης: IN2050 Ltd · Κύπρος · Αρ. Μητρώου HE416406
    </p>
    <p class="mt-8 text-sm">
      <a href="/" class="text-teal-700 underline">English</a>
    </p>
  </section>
</BaseLayout>
