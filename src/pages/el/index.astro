---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import HomePage from "@/components/HomePage.astro";
import { SITE_NAME } from "@/lib/seo";

const pathname = Astro.url.pathname;
const title = `${SITE_NAME} — Τεκμηριωμένος Οδηγός Υπερβαρικής Οξυγονοθεραπείας`;
const description =
  "Τεκμηριωμένος οδηγός υπερβαρικής οξυγονοθεραπείας. Μηχανισμοί, εγκεκριμένες ενδείξεις FDA, κλινικά πρωτόκολλα, εφαρμογές μακροζωίας και αξιολογημένη βιβλιογραφία.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "el",
  description,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  locale="el"
  pathname={pathname}
  ogType="website"
  jsonLd={jsonLd}
  noindex={true}
>
  <Nav slot="nav" locale="el" pathname={pathname} />
  <Footer slot="footer" locale="el" pathname={pathname} />
  <HomePage locale="el" />
</BaseLayout>
