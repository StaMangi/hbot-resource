---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import DetailLayout from "@/layouts/DetailLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ProtocolPanel from "@/components/ProtocolPanel.astro";
import RefTags from "@/components/RefTags.astro";
import { verifyRefs } from "@/lib/refs";
import { t } from "@/i18n";

const locale = "en" as const;
const prefix = "";

export async function getStaticPaths() {
  const entries = await getCollection("indications");
  for (const e of entries) await verifyRefs(e.data.refs, `indications/${e.id}`);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const pathname = Astro.url.pathname;

const evidenceBadge = (level: string) =>
  level === "A"
    ? "bg-emerald-100 text-emerald-800 border-emerald-200"
    : level === "B"
      ? "bg-sky-100 text-sky-800 border-sky-200"
      : "bg-slate-100 text-slate-700 border-slate-200";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: entry.data.condition[locale],
  description: entry.data.description[locale],
  inLanguage: locale,
  mainContentOfPage: {
    "@type": "MedicalCondition",
    name: entry.data.condition[locale],
    description: entry.data.description[locale],
    possibleTreatment: {
      "@type": "MedicalTherapy",
      name: "Hyperbaric Oxygen Therapy",
      relevantSpecialty: { "@type": "MedicalSpecialty", name: "Hyperbaric Medicine" },
    },
  },
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<DetailLayout
  title={`${entry.data.condition[locale]} — HBOT Science`}
  description={entry.data.description[locale]}
  locale={locale}
  pathname={pathname}
  pageHeading={entry.data.condition[locale]}
  eyebrow={entry.data.category[locale]}
  jsonLd={jsonLd}
  noindex={true}
>
  <Breadcrumbs
    slot="breadcrumbs"
    items={[
      { label: "Home", href: "/" },
      { label: t("fda.section.title", locale), href: `${prefix}/indications/` },
      { label: entry.data.condition[locale] },
    ]}
  />

  <div class="flex flex-wrap items-center gap-3 mb-6">
    <span
      class:list={[
        "inline-block px-3 py-1 text-xs font-semibold rounded-md border",
        evidenceBadge(entry.data.evidenceLevel),
      ]}
    >
      Evidence Level {entry.data.evidenceLevel}
    </span>
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
      <Icon name="lucide:check-circle-2" class="w-3.5 h-3.5" />
      {entry.data.evidence[locale]}
    </span>
  </div>

  <p class="text-lg text-slate-700 leading-relaxed">
    {entry.data.description[locale]}
  </p>

  <section class="mt-10">
    <h2 class="text-xl font-semibold text-slate-900 mb-4" style="font-family: var(--font-display)">
      Treatment protocol
    </h2>
    <ProtocolPanel protocol={entry.data.protocol} locale={locale} variant="full" />
  </section>

  {
    entry.data.refs.length > 0 && (
      <section class="mt-10 pt-6 border-t border-slate-200">
        <h2 class="text-base font-semibold text-slate-900 mb-3">{t("dept.refs.label", locale)}</h2>
        <RefTags refs={entry.data.refs} />
        <p class="mt-3 text-xs text-slate-500">
          See full citations on the <a href="/references/" class="text-teal-700 hover:underline">references page</a>.
        </p>
      </section>
    )
  }

  <Fragment slot="aside" />
</DetailLayout>
