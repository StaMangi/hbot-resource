---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import DetailLayout from "@/layouts/DetailLayout.astro";
import AnswerBox from "@/components/AnswerBox.astro";
import RefTags from "@/components/RefTags.astro";
import RelatedAside from "@/components/RelatedAside.astro";
import { verifyRefs } from "@/lib/refs";
import { buildCrossLinkIndex, relatedKey } from "@/lib/cross-links";
import { t } from "@/i18n";

const locale = "es" as const;
const prefix = "/es";

export async function getStaticPaths() {
  const entries = await getCollection("mechanisms");
  for (const e of entries) await verifyRefs(e.data.refs, `es/mechanisms/${e.id}`);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const pathname = Astro.url.pathname;

const iconMap: Record<string, string> = {
  Droplets: "lucide:droplets",
  GitBranch: "lucide:git-branch",
  Shield: "lucide:shield",
  Minimize2: "lucide:minimize-2",
  RefreshCw: "lucide:refresh-cw",
};

const isTeal = entry.data.color === "teal";
const iconBg = isTeal ? "bg-teal-100 text-teal-700" : "bg-slate-100 text-slate-700";

const crossLinks = await buildCrossLinkIndex();
const related = crossLinks.relatedFor.get(relatedKey("mechanisms", entry.id)) ?? [];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: entry.data.title[locale],
  description: entry.data.metaDescription?.[locale] ?? entry.data.summary[locale],
  inLanguage: locale,
  dateModified: entry.data.updated,
  mainContentOfPage: {
    "@type": "MedicalProcedure",
    name: entry.data.title[locale],
    description: entry.data.detail[locale],
    procedureType: "Hyperbaric Oxygen Therapy mechanism of action",
  },
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<DetailLayout
  title={`${entry.data.title[locale]} — HBOT Science`}
  description={entry.data.metaDescription?.[locale] ?? entry.data.summary[locale]}
  locale={locale}
  pathname={pathname}
  pageHeading={entry.data.title[locale]}
  eyebrow="Mecanismo"
  jsonLd={jsonLd}
  lastUpdated={entry.data.updated}
  breadcrumbs={[
    { label: "Inicio", href: "/es/" },
    { label: t("mechanisms.section.title", locale), href: `${prefix}/mechanisms/` },
    { label: entry.data.title[locale] },
  ]}
>
  <AnswerBox text={entry.data.answerBox[locale]} />

  <div class={`w-12 h-12 rounded-xl ${iconBg} flex items-center justify-center mb-6`}>
    <Icon name={iconMap[entry.data.icon] ?? "lucide:circle"} class="w-6 h-6" />
  </div>

  <p class="text-lg text-slate-700 leading-relaxed mb-8">
    {entry.data.summary[locale]}
  </p>

  <h2 class="text-xl font-semibold text-slate-900 mb-3" style="font-family: var(--font-display)">
    Mecanismo detallado
  </h2>
  <p class="text-base text-slate-700 leading-relaxed">
    {entry.data.detail[locale]}
  </p>

  {
    entry.data.refs.length > 0 && (
      <div class="mt-10 pt-6 border-t border-slate-200">
        <h2 class="text-base font-semibold text-slate-900 mb-3">{t("mechanisms.refs.label", locale)}</h2>
        <RefTags refs={entry.data.refs} prefix={prefix} />
        <p class="mt-3 text-xs text-slate-500">
          Referencias completas en la página de <a href="/es/references/" class="text-teal-700 underline underline-offset-2 hover:text-teal-800">bibliografía</a>.
        </p>
      </div>
    )
  }

  <Fragment slot="aside">
    <RelatedAside title="Relacionado" related={related} locale={locale} prefix={prefix} />
  </Fragment>
</DetailLayout>
