---
import { getCollection } from "astro:content";
import IndexLayout from "@/layouts/IndexLayout.astro";

const pathname = Astro.url.pathname;
const locale = "es" as const;

const indications = await getCollection("indications");
const longevity = await getCollection("longevity");

const fdaRows = indications
  .sort((a, b) => a.data.legacyId - b.data.legacyId)
  .map((e) => ({
    slug: e.id,
    label: e.data.condition[locale],
    category: e.data.category[locale],
    protocol: e.data.protocol,
    evidenceLevel: e.data.evidenceLevel,
    href: `/es/indications/${e.id}/`,
  }));

const longevityOrder = ["telomere", "senescence", "cognitive", "stemcells", "athletic", "collagen"];
const longevityRows = longevityOrder
  .map((id) => longevity.find((l) => l.id === id))
  .filter((e): e is NonNullable<typeof e> => e !== undefined)
  .map((e) => ({
    slug: e.id,
    label: e.data.title[locale],
    category: "Longevity",
    protocol: e.data.protocol,
    evidenceLevel: "—",
    href: `/es/longevity/${e.id}/`,
  }));

const evidenceBadge = (level: string) =>
  level === "A"
    ? "bg-emerald-100 text-emerald-800 border-emerald-200"
    : level === "B"
      ? "bg-sky-100 text-sky-800 border-sky-200"
      : "bg-slate-100 text-slate-600 border-slate-200";
---

<IndexLayout
  title="Comparación de protocolos — HBOT Science"
  description="Comparación de los protocolos HBOT para todas las indicaciones aprobadas por la FDA y las aplicaciones de longevidad: presión (ATA), número de sesiones, duración, frecuencia y base de evidencia."
  locale={locale}
  pathname={pathname}
  badge="Referencia"
  pageHeading="Comparación de protocolos"
  pageSubtitle="Comparación de los protocolos HBOT para todas las indicaciones aprobadas por la FDA y las aplicaciones de longevidad. Cmd-P / Ctrl-P para imprimir/PDF."
  badgeColor="navy"
>
  <h2 class="text-xl font-semibold text-slate-900 mb-4" style="font-family: var(--font-display)">
    Indicaciones aprobadas por la FDA ({fdaRows.length})
  </h2>

  <div class="overflow-x-auto rounded-lg border border-slate-200 mb-12">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Indicación</th>
          <th class="text-left px-3 py-3 font-semibold text-slate-700">Presión</th>
          <th class="text-left px-3 py-3 font-semibold text-slate-700">Duración</th>
          <th class="text-left px-3 py-3 font-semibold text-slate-700">Sesiones</th>
          <th class="text-left px-3 py-3 font-semibold text-slate-700">Frecuencia</th>
          <th class="text-left px-3 py-3 font-semibold text-slate-700">Nivel</th>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Evidencia</th>
        </tr>
      </thead>
      <tbody>
        {
          fdaRows.map((row, i) => (
            <tr class:list={["border-b border-slate-100 last:border-b-0 hover:bg-slate-50/60 transition-colors", i % 2 === 0 ? "bg-white" : "bg-slate-50/30"]}>
              <td class="px-4 py-3">
                <a href={row.href} class="font-semibold text-slate-900 hover:text-teal-700">
                  {row.label}
                </a>
                <p class="text-xs text-slate-500 mt-0.5">{row.category}</p>
              </td>
              <td class="px-3 py-3 text-slate-700 whitespace-nowrap">{row.protocol.ata[locale]}</td>
              <td class="px-3 py-3 text-slate-700 whitespace-nowrap">{row.protocol.duration[locale]}</td>
              <td class="px-3 py-3 text-slate-700 whitespace-nowrap">{row.protocol.sessions[locale]}</td>
              <td class="px-3 py-3 text-slate-700">{row.protocol.frequency[locale]}</td>
              <td class="px-3 py-3">
                <span class:list={["inline-block px-2 py-0.5 text-xs font-semibold rounded border", evidenceBadge(row.evidenceLevel)]}>
                  {row.evidenceLevel}
                </span>
              </td>
              <td class="px-4 py-3 text-xs text-slate-600">{row.protocol.basis[locale]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 class="text-xl font-semibold text-slate-900 mb-4" style="font-family: var(--font-display)">
    Aplicaciones de longevidad ({longevityRows.length})
  </h2>

  <div class="overflow-x-auto rounded-lg border border-slate-200">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Aplicación</th>
          <th class="text-left px-3 py-3 font-semibold text-slate-700">Presión</th>
          <th class="text-left px-3 py-3 font-semibold text-slate-700">Duración</th>
          <th class="text-left px-3 py-3 font-semibold text-slate-700">Sesiones</th>
          <th class="text-left px-3 py-3 font-semibold text-slate-700">Frecuencia</th>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Evidencia</th>
        </tr>
      </thead>
      <tbody>
        {
          longevityRows.map((row, i) => (
            <tr class:list={["border-b border-slate-100 last:border-b-0 hover:bg-slate-50/60 transition-colors", i % 2 === 0 ? "bg-white" : "bg-slate-50/30"]}>
              <td class="px-4 py-3">
                <a href={row.href} class="font-semibold text-slate-900 hover:text-teal-700">
                  {row.label}
                </a>
              </td>
              <td class="px-3 py-3 text-slate-700 whitespace-nowrap">{row.protocol.ata[locale]}</td>
              <td class="px-3 py-3 text-slate-700 whitespace-nowrap">{row.protocol.duration[locale]}</td>
              <td class="px-3 py-3 text-slate-700 whitespace-nowrap">{row.protocol.sessions[locale]}</td>
              <td class="px-3 py-3 text-slate-700">{row.protocol.frequency[locale]}</td>
              <td class="px-4 py-3 text-xs text-slate-600">{row.protocol.basis[locale]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-8 text-xs text-slate-500 max-w-3xl">
    Todos los protocolos derivan de publicaciones revisadas por pares, citadas
    en las páginas de detalle de cada indicación. Los niveles de evidencia
    siguen los criterios de evaluación de la UHMS. Para la exportación a PDF
    utilice la función de impresión del navegador (Cmd-P / Ctrl-P).
  </p>
</IndexLayout>
