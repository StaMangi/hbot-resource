---
import { Icon } from "astro-icon/components";
import LandingLayout from "@/layouts/LandingLayout.astro";
import { SITE_NAME } from "@/lib/seo";

const pathname = Astro.url.pathname;
const locale = "es" as const;

const title = `Integración clínica — ${SITE_NAME}`;
const description =
  "HBOT para hospitales y clínicas — indicaciones aprobadas por la FDA, niveles de evidencia, mapeo de aplicaciones por servicio, protocolos y recomendaciones estratégicas.";

const libraryLinks = [
  { href: "/es/indications/", icon: "lucide:list-checks", title: "Indicaciones aprobadas por la FDA", body: "Las 14 condiciones reconocidas por la UHMS, con niveles de evidencia y protocolos." },
  { href: "/es/evidence/", icon: "lucide:book-open", title: "Evidencia científica", body: "ECA y metaanálisis seleccionados procedentes de las disciplinas clínicas." },
  { href: "/es/protocols/", icon: "lucide:gauge", title: "Comparación de protocolos", body: "Tabla comparativa de los protocolos — presión, sesiones, duración, frecuencia." },
  { href: "/es/safety/", icon: "lucide:shield-alert", title: "Seguridad y contraindicaciones", body: "Contraindicaciones absolutas y relativas, eventos adversos, listas de verificación." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "es",
  description,
  audience: { "@type": "MedicalAudience", audienceType: "MedicalProfessional" },
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title={title}
  description={description}
  locale={locale}
  pathname={pathname}
  ogType="website"
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="bg-gradient-to-br from-teal-50 via-white to-slate-50">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
      <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-100 text-teal-800">
        Para hospitales y clínicas
      </span>
      <h1
        class="mt-4 text-4xl md:text-5xl font-bold text-slate-900 leading-tight max-w-3xl"
        style="font-family: var(--font-display)"
      >
        Integración clínica de la oxigenoterapia hiperbárica
      </h1>
      <p class="mt-5 text-lg text-slate-600 leading-relaxed max-w-3xl">
        Indicaciones aprobadas por la FDA, niveles de evidencia, mapeo de las
        aplicaciones por servicio, protocolos y recomendaciones estratégicas para
        la integración de servicios HBOT en un programa hospitalario.
      </p>
    </div>
  </section>

  {/* Department mapping — teaser (the full twelve-card grid lives on /es/departments/) */}
  <section class="max-w-6xl mx-auto px-6 pt-8 pb-16 md:pt-10 md:pb-20">
    <div class="max-w-2xl">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900"
        style="font-family: var(--font-display)"
      >
        Mapeo por servicio
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Doce especialidades clínicas cuentan con aplicaciones HBOT documentadas.
        Cada servicio dispone de su propia página con la lista completa de las
        indicaciones aprobadas por la FDA y en fase de investigación, de los
        protocolos y de las citas.
      </p>
      <p class="mt-6">
        <a href="/es/departments/" class="text-teal-700 underline underline-offset-2 hover:text-teal-800 font-semibold">Todos los servicios →</a>
      </p>
    </div>
  </section>

  {/* Library quick-links */}
  <section class="bg-slate-50 py-16 md:py-20 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-6">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900 mb-10"
        style="font-family: var(--font-display)"
      >
        Material de referencia
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          libraryLinks.map((link) => (
            <a
              href={link.href}
              class="group block rounded-xl border border-slate-200 bg-white p-5 hover:border-teal-300 hover:shadow-sm transition-all"
            >
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center flex-shrink-0 group-hover:bg-teal-100 group-hover:text-teal-700 transition-colors">
                  <Icon name={link.icon} class="w-5 h-5" />
                </div>
                <div class="min-w-0">
                  <h3
                    class="text-base font-semibold text-slate-900 group-hover:text-teal-700 transition-colors"
                    style="font-family: var(--font-display)"
                  >
                    {link.title}
                  </h3>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{link.body}</p>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</LandingLayout>
