---
import { getCollection } from "astro:content";
import LandingLayout from "@/layouts/LandingLayout.astro";
import HomeStat from "@/components/HomeStat.astro";
import HomePathCard from "@/components/HomePathCard.astro";
import HomeLibraryTile from "@/components/HomeLibraryTile.astro";
import { SITE_NAME } from "@/lib/seo";
import { t } from "@/i18n";

const pathname = Astro.url.pathname;
const locale = "es" as const;

const title = `${SITE_NAME} — Guía de la HBOT basada en la evidencia`;
const description =
  "Guía basada en la evidencia sobre la oxigenoterapia hiperbárica. Mecanismos, indicaciones aprobadas por la FDA, protocolos clínicos, aplicaciones de longevidad y literatura curada.";

const indications = await getCollection("indications");
const fdaCount = indications.filter((e) => e.data.tier === "fda-approved").length;
const emergingCount = indications.filter((e) => e.data.tier === "emerging").length;
const totalIndications = fdaCount + emergingCount;

const stats = [
  { value: String(fdaCount), label: t("stat.fda.label", locale), sub: t("stat.fda.sub", locale) },
  { value: ">20%", label: t("stat.telomere.label", locale), sub: t("stat.telomere.sub", locale) },
  { value: "258", label: t("stat.citations.label", locale), sub: t("stat.citations.sub", locale) },
  { value: "2.0–3.0 ATA", label: t("stat.pressure.label", locale), sub: t("stat.pressure.sub", locale) },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "es",
  description,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title={title}
  description={description}
  locale={locale}
  pathname={pathname}
  ogType="website"
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-teal-50/40">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-100 text-teal-800">
          Guía de la HBOT basada en la evidencia
        </span>
        <h1
          class="mt-5 text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 leading-tight"
          style="font-family: var(--font-display)"
        >
          La <span class="text-teal-700">referencia científica</span> para
          la oxigenoterapia hiperbárica.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-slate-600 leading-relaxed">
          Mecanismos, indicaciones aprobadas por la FDA, protocolos clínicos,
          aplicaciones de longevidad y literatura curada. Sin marketing,
          sin chatbot — solo lo que la literatura respalda.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-10 max-w-4xl">
        {stats.map((s) => <HomeStat {...s} />)}
      </div>
    </div>
  </section>

  {/* Two soft-routing path cards */}
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900"
        style="font-family: var(--font-display)"
      >
        Dos recorridos, una única base de evidencia
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Los hospitales y los centros de longevidad se aproximan a la HBOT desde
        perspectivas distintas — pero la ciencia subyacente es la misma.
        Elija el recorrido que mejor se ajuste a su consulta.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <HomePathCard
        href="/es/clinical/"
        icon="lucide:stethoscope"
        eyebrow="Para hospitales y clínicas"
        title="Integración clínica"
        body="Indicaciones aprobadas por la FDA, niveles de evidencia, mapeo de aplicaciones por servicio, protocolos y recomendaciones estratégicas para la integración hospitalaria."
        cta="Explore el ámbito clínico"
        variant="clinical"
      />
      <HomePathCard
        href="/es/longevity/"
        icon="lucide:sparkles"
        eyebrow="Para centros de bienestar y longevidad"
        title="Bienestar y longevidad"
        body="Alargamiento de los telómeros, reducción de células senescentes, mejora cognitiva, recuperación atlética — protocolos, evidencia y arquitectura de referencia."
        cta="Explore la longevidad"
        variant="wellness"
      />
    </div>
  </section>

  {/* Shared library preview */}
  <section class="bg-slate-50 py-16 md:py-20 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <h2
          class="text-2xl md:text-3xl font-semibold text-slate-900"
          style="font-family: var(--font-display)"
        >
          Biblioteca de referencia
        </h2>
        <p class="mt-3 text-slate-600 leading-relaxed">
          El mismo material de origen, organizado para la consulta
          directa. Enlazado desde los dos recorridos de arriba y desde cada
          página de detalle del sitio.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <HomeLibraryTile
          href="/es/mechanisms/"
          icon="lucide:atom"
          title="Mecanismos de acción"
          body="Cinco mecanismos fisiológicos — hiperoxigenación, angiogénesis, acción antimicrobiana, reducción del volumen de los gases, vías antienvejecimiento."
        />
        <HomeLibraryTile
          href="/es/indications/"
          icon="lucide:list-checks"
          title="Indicaciones"
          body={`${totalIndications} indicaciones en dos niveles de evidencia — ${fdaCount} aprobadas por la FDA (reconocidas por la UHMS) y ${emergingCount} emergentes — con niveles de evidencia, protocolos y referencias clave.`}
        />
        <HomeLibraryTile
          href="/es/evidence/"
          icon="lucide:book-open"
          title="Evidencia científica"
          body="ECA, metaanálisis y estudios prospectivos curados — enlaces DOI a las publicaciones."
        />
        <HomeLibraryTile
          href="/es/references/"
          icon="lucide:bookmark"
          title="Bibliografía"
          body="Todas las fuentes citadas con enlaces directos. El fundamento de evidencia detrás de cada afirmación del sitio."
        />
      </div>
    </div>
  </section>
</LandingLayout>
