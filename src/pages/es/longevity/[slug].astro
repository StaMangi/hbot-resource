---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import DetailLayout from "@/layouts/DetailLayout.astro";
import ProtocolPanel from "@/components/ProtocolPanel.astro";
import RefTags from "@/components/RefTags.astro";
import RelatedAside from "@/components/RelatedAside.astro";
import { verifyRefs } from "@/lib/refs";
import { buildCrossLinkIndex, relatedKey } from "@/lib/cross-links";
import { t } from "@/i18n";

const locale = "es" as const;
const prefix = "/es";

const crossLinks = await buildCrossLinkIndex();

export async function getStaticPaths() {
  const entries = await getCollection("longevity");
  for (const e of entries) {
    if (e.data.refs) await verifyRefs(e.data.refs, `es/longevity/${e.id}`);
  }
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const pathname = Astro.url.pathname;
const related = crossLinks.relatedFor.get(relatedKey("longevity", entry.id)) ?? [];

const iconMap: Record<string, string> = {
  Dna: "lucide:dna",
  Trash2: "lucide:trash-2",
  Brain: "lucide:brain",
  Sparkles: "lucide:sparkles",
  Zap: "lucide:zap",
  Layers: "lucide:layers",
};

const isTeal = entry.data.color === "teal";
const iconBg = isTeal ? "bg-teal-100 text-teal-700" : "bg-slate-200 text-slate-700";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: entry.data.title[locale],
  description: entry.data.summary[locale],
  inLanguage: locale,
  dateModified: entry.data.updated,
  mainContentOfPage: {
    "@type": "MedicalProcedure",
    name: entry.data.title[locale],
    description: entry.data.mechanism[locale],
    procedureType: "Hyperbaric Oxygen Therapy longevity application",
  },
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<DetailLayout
  title={`${entry.data.title[locale]} — HBOT Science`}
  description={entry.data.summary[locale]}
  locale={locale}
  pathname={pathname}
  pageHeading={entry.data.title[locale]}
  eyebrow="Aplicación en longevidad"
  jsonLd={jsonLd}
  lastUpdated={entry.data.updated}
  breadcrumbs={[
    { label: "Inicio", href: "/es/" },
    { label: t("longevity.section.title", locale), href: `${prefix}/longevity/` },
    { label: entry.data.title[locale] },
  ]}
>

  <div class="flex items-start justify-between gap-6 mb-8">
    <div class={`w-12 h-12 rounded-xl ${iconBg} flex items-center justify-center flex-shrink-0`}>
      <Icon name={iconMap[entry.data.icon] ?? "lucide:circle"} class="w-6 h-6" />
    </div>
    <div class="text-right">
      <p class="text-3xl font-bold text-teal-700" style="font-family: var(--font-display)">
        {entry.data.stat}
      </p>
      <p class="text-xs text-slate-500">{entry.data.statLabel[locale]}</p>
    </div>
  </div>

  <p class="text-lg text-slate-700 leading-relaxed">
    {entry.data.summary[locale]}
  </p>

  <section class="mt-10">
    <h2 class="text-xl font-semibold text-slate-900 mb-4" style="font-family: var(--font-display)">
      {t("longevity.mechanism.label", locale)}
    </h2>
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-6">
      <p class="text-base text-slate-700 leading-relaxed">{entry.data.mechanism[locale]}</p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold text-slate-900 mb-4" style="font-family: var(--font-display)">
      Protocolo de tratamiento
    </h2>
    <ProtocolPanel protocol={entry.data.protocol} locale={locale} variant="full" />
  </section>

  {
    entry.data.refs && entry.data.refs.length > 0 && (
      <section class="mt-10 pt-6 border-t border-slate-200">
        <h2 class="text-base font-semibold text-slate-900 mb-3">{t("longevity.refs.label", locale)}</h2>
        <RefTags refs={entry.data.refs} prefix={prefix} />
        <p class="mt-3 text-xs text-slate-500">
          Referencias completas en la página de <a href="/es/references/" class="text-teal-700 underline underline-offset-2 hover:text-teal-800">bibliografía</a>.
        </p>
      </section>
    )
  }

  <Fragment slot="aside">
    <RelatedAside title="Relacionado" related={related} locale={locale} prefix={prefix} />
  </Fragment>
</DetailLayout>
