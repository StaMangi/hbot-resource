---
import LandingLayout from "@/layouts/LandingLayout.astro";
import StubContent from "@/components/StubContent.astro";

const pathname = Astro.url.pathname;
const locale = "en" as const;
---

<LandingLayout
  title="Operator Blueprint — HBOT Science"
  description="Reference architecture for hotels and longevity centres adopting HBOT — space requirements, staffing model, regulatory checklist, member journey design."
  locale={locale}
  pathname={pathname}
  noindex={true}
>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <p class="text-xs uppercase tracking-widest text-slate-500">Operator reference</p>
    <h1 class="mt-3 text-4xl font-semibold text-slate-900" style="font-family: var(--font-display)">
      Operator Blueprint
    </h1>
    <StubContent phase="4" locale={locale} />
  </section>
</LandingLayout>
