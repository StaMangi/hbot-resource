---
import { getCollection } from "astro:content";
import LandingLayout from "@/layouts/LandingLayout.astro";
import HomeStat from "@/components/HomeStat.astro";
import HomePathCard from "@/components/HomePathCard.astro";
import HomeLibraryTile from "@/components/HomeLibraryTile.astro";
import { SITE_NAME } from "@/lib/seo";
import { t } from "@/i18n";

const pathname = Astro.url.pathname;
const locale = "de" as const;

const title = `${SITE_NAME} — Evidenzbasierter HBOT-Leitfaden`;
const description =
  "Evidenzbasierter Leitfaden zur hyperbaren Sauerstofftherapie. Mechanismen, FDA-zugelassene Indikationen, klinische Protokolle, Longevity-Anwendungen und kuratierte Literatur.";

const indications = await getCollection("indications");
const fdaCount = indications.filter((e) => e.data.tier === "fda-approved").length;
const emergingCount = indications.filter((e) => e.data.tier === "emerging").length;
const totalIndications = fdaCount + emergingCount;

const stats = [
  { value: String(fdaCount), label: t("stat.fda.label", locale), sub: t("stat.fda.sub", locale) },
  { value: ">20%", label: t("stat.telomere.label", locale), sub: t("stat.telomere.sub", locale) },
  { value: "258", label: t("stat.citations.label", locale), sub: t("stat.citations.sub", locale) },
  { value: "2.0–3.0 ATA", label: t("stat.pressure.label", locale), sub: t("stat.pressure.sub", locale) },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "de",
  description,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title={title}
  description={description}
  locale={locale}
  pathname={pathname}
  ogType="website"
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-teal-50/40">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-100 text-teal-800">
          Evidenzbasierter HBOT-Leitfaden
        </span>
        <h1
          class="mt-5 text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 leading-tight"
          style="font-family: var(--font-display)"
        >
          Die <span class="text-teal-700">wissenschaftliche Referenz</span> zur
          hyperbaren Sauerstofftherapie.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-slate-600 leading-relaxed">
          Mechanismen, FDA-zugelassene Indikationen, klinische Protokolle,
          Longevity-Anwendungen und kuratierte Literatur. Ohne Marketing, ohne
          Chatbot — nur das, was die Literatur stützt.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-10 max-w-4xl">
        {stats.map((s) => <HomeStat {...s} />)}
      </div>
    </div>
  </section>

  {/* Two soft-routing path cards */}
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900"
        style="font-family: var(--font-display)"
      >
        Zwei Wege, eine Evidenzbasis
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Krankenhäuser und Longevity-Zentren nähern sich der HBOT aus
        unterschiedlichen Blickwinkeln — die zugrundeliegende Wissenschaft
        ist jedoch dieselbe. Wählen Sie den Weg, der zu Ihrer Frage passt.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <HomePathCard
        href="/de/clinical/"
        icon="lucide:stethoscope"
        eyebrow="Für Krankenhäuser & Kliniken"
        title="Klinische Integration"
        body="FDA-zugelassene Indikationen, Evidenzstufen, Anwendungs-Mapping nach Abteilung, Protokolle und strategische Empfehlungen für die Krankenhaus-Integration."
        cta="Klinik erkunden"
        variant="clinical"
      />
      <HomePathCard
        href="/de/wellness/"
        icon="lucide:sparkles"
        eyebrow="Für Wellness- & Longevity-Zentren"
        title="Wellness & Longevity"
        body="Telomerverlängerung, Reduktion seneszenter Zellen, kognitive Förderung, sportliche Erholung — Protokolle, Evidenz und Referenz-Architektur."
        cta="Wellness erkunden"
        variant="wellness"
      />
    </div>
  </section>

  {/* Shared library preview */}
  <section class="bg-slate-50 py-16 md:py-20 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <h2
          class="text-2xl md:text-3xl font-semibold text-slate-900"
          style="font-family: var(--font-display)"
        >
          Referenzbibliothek
        </h2>
        <p class="mt-3 text-slate-600 leading-relaxed">
          Dasselbe Quellenmaterial, organisiert für die direkte Recherche.
          Verlinkt von den beiden Wegen oben und von jeder Detailseite der
          Website.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <HomeLibraryTile
          href="/de/mechanisms/"
          icon="lucide:atom"
          title="Wirkmechanismen"
          body="Fünf physiologische Mechanismen — Hyperoxygenierung, Angiogenese, antimikrobielle Wirkung, Gasvolumen-Reduktion, Anti-Aging-Wege."
        />
        <HomeLibraryTile
          href="/de/indications/"
          icon="lucide:list-checks"
          title="Indikationen"
          body={`${totalIndications} Indikationen auf zwei Evidenzstufen — ${fdaCount} FDA-zugelassen (UHMS-anerkannt) und ${emergingCount} aufkommend — mit Evidenzstufen, Protokollen und Schlüsselreferenzen.`}
        />
        <HomeLibraryTile
          href="/de/evidence/"
          icon="lucide:book-open"
          title="Wissenschaftliche Evidenz"
          body="Kuratierte RKS, Meta-Analysen und prospektive Studien — DOI-Links zu den Veröffentlichungen."
        />
        <HomeLibraryTile
          href="/de/references/"
          icon="lucide:bookmark"
          title="Literatur"
          body="Sämtliche zitierten Quellen mit Direktlinks. Das Evidenzrückgrat hinter jeder Aussage auf der Website."
        />
      </div>
    </div>
  </section>
</LandingLayout>
