---
import { getCollection } from "astro:content";
import IndexLayout from "@/layouts/IndexLayout.astro";
import DepartmentCard from "@/components/cards/DepartmentCard.astro";
import { t } from "@/i18n";

const pathname = Astro.url.pathname;
const locale = "de" as const;

const all = await getCollection("departments");
const order = [
  "surgery",
  "neurology",
  "oncology",
  "gastroenterology",
  "endocrinology",
  "ent",
  "ophthalmology",
  "psychiatry",
  "geriatrics",
  "dermatology",
  "plastic-surgery",
  "womens-health",
];
const entries = order
  .map((id) => all.find((d) => d.id === id))
  .filter((d): d is NonNullable<typeof d> => d !== undefined);
---

<IndexLayout
  title={`${t("dept.section.title", locale)} — HBOT Science`}
  description={t("dept.section.subtitle", locale)}
  locale={locale}
  pathname={pathname}
  badge={t("dept.section.badge", locale)}
  pageHeading={t("dept.section.title", locale)}
  pageSubtitle={t("dept.section.subtitle", locale)}
  badgeColor="teal"
>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {entries.map((entry) => <DepartmentCard entry={entry} locale={locale} prefix="/de" />)}
  </div>

  <div class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6">
    <p class="text-sm text-slate-700">
      Sie suchen Abteilungen, in denen HBOT <em>nicht</em> angewendet wird?{" "}
      <a href="/de/departments/without-hbot/" class="text-teal-700 underline underline-offset-2 hover:text-teal-800 font-semibold">
        Abteilungen ohne HBOT-Anwendungen →
      </a>
    </p>
  </div>
</IndexLayout>
