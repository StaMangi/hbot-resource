---
import LandingLayout from "@/layouts/LandingLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { t } from "@/i18n";

const pathname = Astro.url.pathname;
const locale = "de" as const;

const description = t("contact.metaDescription", locale);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: t("contact.heading", locale),
  description,
  inLanguage: locale,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title={t("contact.pageTitle", locale)}
  description={description}
  locale={locale}
  pathname={pathname}
  jsonLd={jsonLd}
>
  <article class="max-w-2xl mx-auto px-6 py-16">
    <p class="text-xs uppercase tracking-widest text-slate-500">
      {t("contact.eyebrow", locale)}
    </p>
    <h1
      class="mt-3 text-4xl font-semibold text-slate-900"
      style="font-family: var(--font-display)"
    >
      {t("contact.heading", locale)}
    </h1>
    <p class="mt-4 text-lg text-slate-700 leading-relaxed">
      {t("contact.intro", locale)}
    </p>

    <div class="mt-10">
      <ContactForm locale={locale} />
    </div>
  </article>
</LandingLayout>
