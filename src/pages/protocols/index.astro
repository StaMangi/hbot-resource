---
import IndexLayout from "@/layouts/IndexLayout.astro";
import StubContent from "@/components/StubContent.astro";

const pathname = Astro.url.pathname;
const locale = "en" as const;
---

<IndexLayout
  title="Protocol Comparison Matrix — HBOT Science"
  description="Side-by-side comparison of all FDA-approved HBOT protocols: pressure (ATA), session count, duration, frequency, and evidence basis."
  locale={locale}
  pathname={pathname}
  badge="Reference"
  pageHeading="Protocol Comparison"
  pageSubtitle="Side-by-side comparison of HBOT protocols across all FDA-approved indications."
  badgeColor="navy"
  noindex={true}
>
  <StubContent phase="3.C" locale={locale} />
</IndexLayout>
