---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — HBOT Resource"
  description="The page you requested could not be found."
  locale="en"
  pathname="/404/"
  noindex={true}
>
  <section class="max-w-2xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-semibold text-slate-900">404 — Page not found</h1>
    <p class="mt-6 text-slate-700">
      The page you requested does not exist.
    </p>
    <p class="mt-8">
      <a href="/" class="text-teal-700 underline">Back to home</a>
    </p>
  </section>
</BaseLayout>
