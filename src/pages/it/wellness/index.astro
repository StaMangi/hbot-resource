---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import LandingLayout from "@/layouts/LandingLayout.astro";
import { SITE_NAME } from "@/lib/seo";

const pathname = Astro.url.pathname;
const locale = "it" as const;

const title = `Benessere e longevità — ${SITE_NAME}`;
const description =
  "HBOT per programmi di benessere e longevità — allungamento dei telomeri, riduzione delle cellule senescenti, potenziamento cognitivo, recupero sportivo — protocolli, evidenza e architettura di riferimento.";

const longevityAll = await getCollection("longevity");
const order = ["telomere", "senescence", "cognitive", "stemcells", "athletic", "collagen"];
const apps = order
  .map((id) => longevityAll.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => a !== undefined);

const longevityIcons: Record<string, string> = {
  Dna: "lucide:dna",
  Trash2: "lucide:trash-2",
  Brain: "lucide:brain",
  Sparkles: "lucide:sparkles",
  Zap: "lucide:zap",
  Layers: "lucide:layers",
};

const operatorLinks = [
  { href: "/it/programme-design/", icon: "lucide:clipboard-list", title: "Progettazione del programma di 60 sedute", body: "Percorso del membro, monitoraggio dei biomarcatori, cadenza del protocollo e integrazione con metodiche complementari." },
  { href: "/it/operator-blueprint/", icon: "lucide:building-2", title: "Architettura dell'operatore", body: "Requisiti degli spazi, modello del personale, checklist normativa, progettazione dell'esperienza del membro." },
  { href: "/it/mechanisms/antiaging/", icon: "lucide:atom", title: "Meccanismo anti-invecchiamento", body: "Il paradosso iperossico-ipossico — stress ormetico, attivazione della telomerasi, vie senolitiche." },
  { href: "/it/evidence/", icon: "lucide:book-open", title: "Evidenza sulla longevità", body: "Lo studio Hadanny 2020 e le successive metanalisi sull'HBOT relative all'invecchiamento sano e alla performance cognitiva." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "it",
  description,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title={title}
  description={description}
  locale={locale}
  pathname={pathname}
  ogType="website"
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="bg-gradient-to-br from-slate-50 via-white to-cyan-50/40">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
      <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-violet-100 text-violet-800">
        Per centri di benessere e longevità
      </span>
      <h1
        class="mt-4 text-4xl md:text-5xl font-bold text-slate-900 leading-tight max-w-3xl"
        style="font-family: var(--font-display)"
      >
        Applicazioni dell'HBOT nel benessere e nella longevità
      </h1>
      <p class="mt-5 text-lg text-slate-600 leading-relaxed max-w-3xl">
        Allungamento dei telomeri, riduzione delle cellule senescenti,
        potenziamento cognitivo, recupero sportivo — protocolli, base di
        evidenza e architettura di riferimento per hotel e centri di longevità.
      </p>
    </div>
  </section>

  {/* Longevity applications grid */}
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900"
        style="font-family: var(--font-display)"
      >
        Sei applicazioni per la longevità
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Ciascuna delle sei applicazioni per la longevità dispone di una pagina
        dedicata con il meccanismo, i parametri del protocollo, gli studi di
        supporto e le referenze principali.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        apps.map((app) => {
          const isTeal = app.data.color === "teal";
          const accent = isTeal ? "bg-teal-100 text-teal-700" : "bg-slate-200 text-slate-700";
          return (
            <a
              href={`/it/longevity/${app.id}/`}
              class="group block rounded-xl border border-slate-200 bg-white p-5 hover:border-teal-300 hover:shadow-sm transition-all"
            >
              <div class="flex items-start justify-between gap-3 mb-3">
                <div class:list={[`w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0`, accent]}>
                  <Icon name={longevityIcons[app.data.icon] ?? "lucide:circle"} class="w-5 h-5" />
                </div>
                <p
                  class="text-2xl font-bold text-teal-700"
                  style="font-family: var(--font-display)"
                >
                  {app.data.stat}
                </p>
              </div>
              <h3
                class="text-base font-semibold text-slate-900 group-hover:text-teal-700 transition-colors"
                style="font-family: var(--font-display)"
              >
                {app.data.title[locale]}
              </h3>
              <p class="mt-1 text-xs text-slate-500 mb-3">{app.data.statLabel[locale]}</p>
              <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">
                {app.data.summary[locale]}
              </p>
            </a>
          );
        })
      }
    </div>

    <p class="mt-8 text-sm text-slate-500">
      Cerchi l'elenco completo della longevità?{" "}
      <a href="/it/longevity/" class="text-teal-700 underline underline-offset-2 hover:text-teal-800 font-semibold">Tutte le applicazioni →</a>
    </p>
  </section>

  {/* Operator references */}
  <section class="bg-slate-50 py-16 md:py-20 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-6">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900 mb-10"
        style="font-family: var(--font-display)"
      >
        Progettazione del programma e architettura dell'operatore
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          operatorLinks.map((link) => (
            <a
              href={link.href}
              class="group block rounded-xl border border-slate-200 bg-white p-5 hover:border-teal-300 hover:shadow-sm transition-all"
            >
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center flex-shrink-0 group-hover:bg-teal-100 group-hover:text-teal-700 transition-colors">
                  <Icon name={link.icon} class="w-5 h-5" />
                </div>
                <div class="min-w-0">
                  <h3
                    class="text-base font-semibold text-slate-900 group-hover:text-teal-700 transition-colors"
                    style="font-family: var(--font-display)"
                  >
                    {link.title}
                  </h3>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{link.body}</p>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="max-w-3xl mx-auto px-6 py-16 md:py-20 text-center">
    <h2
      class="text-2xl md:text-3xl font-semibold text-slate-900 mb-3"
      style="font-family: var(--font-display)"
    >
      State pianificando un programma di longevità?
    </h2>
    <p class="text-slate-600 leading-relaxed mb-8">
      L'editore IN2050 Ltd offre briefing per operatori sulla progettazione del
      programma, sul percorso del membro, sui percorsi normativi e sulla
      supervisione clinica per hotel e centri di longevità che introducono
      l'HBOT.
    </p>
    <a
      href="mailto:info@hbotscience.org?subject=Operator-Briefing"
      class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-slate-800 hover:bg-slate-900 text-white font-semibold transition-colors"
    >
      <Icon name="lucide:mail" class="w-4 h-4" />
      Richiedi un briefing per operatori
    </a>
  </section>
</LandingLayout>
