---
import { getCollection } from "astro:content";
import LandingLayout from "@/layouts/LandingLayout.astro";
import HomeStat from "@/components/HomeStat.astro";
import HomePathCard from "@/components/HomePathCard.astro";
import HomeLibraryTile from "@/components/HomeLibraryTile.astro";
import { SITE_NAME } from "@/lib/seo";
import { t } from "@/i18n";

const pathname = Astro.url.pathname;
const locale = "en" as const;

const title = `${SITE_NAME} — Evidence-Based HBOT Reference`;
const description =
  "Evidence-based hyperbaric oxygen therapy reference. Mechanisms, FDA-approved indications, clinical protocols, longevity applications, and peer-reviewed evidence.";

// Build-time counts — drive the homepage tile copy. Phase 5 audit fix:
// homepage previously had hardcoded "Fourteen" + "Twenty-four" which went
// stale as Phase 4 added 5 emerging indications and 20 references. Compute
// at build instead to keep these in sync with the collections forever.
const indications = await getCollection("indications");
const fdaCount = indications.filter((e) => e.data.tier === "fda-approved").length;
const emergingCount = indications.filter((e) => e.data.tier === "emerging").length;
const totalIndications = fdaCount + emergingCount;

const stats = [
  { value: String(fdaCount), label: t("stat.fda.label", locale), sub: t("stat.fda.sub", locale) },
  { value: ">20%", label: t("stat.telomere.label", locale), sub: t("stat.telomere.sub", locale) },
  { value: "258", label: t("stat.citations.label", locale), sub: t("stat.citations.sub", locale) },
  { value: "2.0–3.0 ATA", label: t("stat.pressure.label", locale), sub: t("stat.pressure.sub", locale) },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "en",
  description,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title={title}
  description={description}
  locale={locale}
  pathname={pathname}
  ogType="website"
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-teal-50/40">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-100 text-teal-800">
          Evidence-based HBOT reference
        </span>
        <h1
          class="mt-5 text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 leading-tight"
          style="font-family: var(--font-display)"
        >
          The <span class="text-teal-700">scientific reference</span> for
          hyperbaric oxygen therapy.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-slate-600 leading-relaxed">
          Mechanisms, FDA-approved indications, clinical protocols, longevity
          applications, and peer-reviewed evidence. No marketing, no chatbot —
          only what the literature supports.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-10 max-w-4xl">
        {stats.map((s) => <HomeStat {...s} />)}
      </div>
    </div>
  </section>

  {/* Two soft-routing path cards */}
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900"
        style="font-family: var(--font-display)"
      >
        Two paths, one evidence base
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Hospitals and longevity operators come to HBOT from different angles —
        but the underlying science is the same. Pick the path that matches your
        starting question.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <HomePathCard
        href="/clinical/"
        icon="lucide:stethoscope"
        eyebrow="For hospitals & clinics"
        title="Clinical Integration"
        body="FDA-approved indications, evidence levels, departmental application mapping, protocol summaries, and strategic recommendations for hospital integration."
        cta="Explore clinical"
        variant="clinical"
      />
      <HomePathCard
        href="/wellness/"
        icon="lucide:sparkles"
        eyebrow="For wellness & longevity operators"
        title="Wellness & Longevity"
        body="Telomere lengthening, senescent cell reduction, cognitive enhancement, athletic recovery — protocols, evidence, and operator reference architecture."
        cta="Explore wellness"
        variant="wellness"
      />
    </div>
  </section>

  {/* Shared library preview */}
  <section class="bg-slate-50 py-16 md:py-20 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <h2
          class="text-2xl md:text-3xl font-semibold text-slate-900"
          style="font-family: var(--font-display)"
        >
          Reference library
        </h2>
        <p class="mt-3 text-slate-600 leading-relaxed">
          The same source material, organised for direct lookup. Linked from
          both paths above and from every detail page across the site.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <HomeLibraryTile
          href="/mechanisms/"
          icon="lucide:atom"
          title="Mechanisms of Action"
          body="Five physiological mechanisms — hyperoxygenation, angiogenesis, antimicrobial activity, gas reduction, anti-ageing pathways."
        />
        <HomeLibraryTile
          href="/indications/"
          icon="lucide:list-checks"
          title="Indications"
          body={`${totalIndications} indications across two evidence tiers — ${fdaCount} FDA-approved (UHMS-recognised) and ${emergingCount} emerging — with evidence levels, protocols, and key references.`}
        />
        <HomeLibraryTile
          href="/evidence/"
          icon="lucide:book-open"
          title="Evidence Base"
          body="Peer-reviewed RCTs, meta-analyses, and prospective studies — DOI links to source publications."
        />
        <HomeLibraryTile
          href="/references/"
          icon="lucide:bookmark"
          title="Bibliography"
          body="All cited sources with direct links. Used as the citation backbone across every claim on the site."
        />
      </div>
    </div>
  </section>
</LandingLayout>
