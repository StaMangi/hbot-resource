---
import { getCollection } from "astro:content";
import LandingLayout from "@/layouts/LandingLayout.astro";
import HomeStat from "@/components/HomeStat.astro";
import HomePathCard from "@/components/HomePathCard.astro";
import HomeLibraryTile from "@/components/HomeLibraryTile.astro";
import { SITE_NAME } from "@/lib/seo";
import { t } from "@/i18n";

const pathname = Astro.url.pathname;
const locale = "fr" as const;

const title = `${SITE_NAME} — Référence HBOT fondée sur les preuves`;
const description =
  "Référence fondée sur les preuves consacrée à l'oxygénothérapie hyperbare. Mécanismes, indications approuvées par l'UHMS, protocoles cliniques, applications en longévité et données publiées dans des revues à comité de lecture.";

const indications = await getCollection("indications");
// Was a hardcoded "258" with no source; now the size of the verified bibliography.
const referenceCount = (await getCollection("references")).length;
const fdaCount = indications.filter((e) => e.data.tier === "fda-approved").length;
// Distinct UHMS indication numbers: CRAO and problem wounds share #6, so
// pages ≠ indications.
const uhmsCount = new Set(
  indications.filter((e) => e.data.tier === "fda-approved").map((e) => e.data.uhms),
).size;
const emergingCount = indications.filter((e) => e.data.tier === "emerging").length;
const totalIndications = fdaCount + emergingCount;

const stats = [
  { value: String(uhmsCount), label: t("stat.fda.label", locale), sub: t("stat.fda.sub", locale) },
  { value: ">20%", label: t("stat.telomere.label", locale), sub: t("stat.telomere.sub", locale) },
  { value: String(referenceCount), label: t("stat.citations.label", locale), sub: t("stat.citations.sub", locale) },
  { value: "2.0–3.0 ATA", label: t("stat.pressure.label", locale), sub: t("stat.pressure.sub", locale) },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: "fr",
  description,
  publisher: {
    "@type": "Organization",
    name: "IN2050 Ltd",
    address: { "@type": "PostalAddress", addressCountry: "CY" },
    identifier: "HE416406",
  },
};
---

<LandingLayout
  title={title}
  description={description}
  locale={locale}
  pathname={pathname}
  ogType="website"
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-teal-50/40">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-widest uppercase rounded-full bg-teal-100 text-teal-800">
          Référence HBOT fondée sur les preuves
        </span>
        <h1
          class="mt-5 text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 leading-tight"
          style="font-family: var(--font-display)"
        >
          La <span class="text-teal-700">référence scientifique</span> de
          l'oxygénothérapie hyperbare.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-slate-600 leading-relaxed">
          Mécanismes, indications approuvées par l'UHMS, protocoles cliniques,
          applications en longévité et données publiées dans des revues à comité
          de lecture. Ni marketing, ni chatbot — uniquement ce que la littérature
          étaye.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-10 max-w-4xl">
        {stats.map((s) => <HomeStat {...s} />)}
      </div>
    </div>
  </section>

  {/* Two soft-routing path cards */}
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <h2
        class="text-2xl md:text-3xl font-semibold text-slate-900"
        style="font-family: var(--font-display)"
      >
        Deux parcours, une même base de preuves
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Les hôpitaux et les centres de longévité abordent l'HBOT sous des angles
        différents — mais la science sous-jacente est la même. Choisissez le
        parcours qui correspond à votre question de départ.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <HomePathCard
        href="/fr/clinical/"
        icon="lucide:stethoscope"
        eyebrow="Pour les hôpitaux et les cliniques"
        title="Intégration clinique"
        body="Indications approuvées par l'UHMS, niveaux de preuve, correspondance des applications par service, synthèses des protocoles et recommandations stratégiques pour l'intégration hospitalière."
        cta="Découvrir le volet clinique"
        variant="clinical"
      />
      <HomePathCard
        href="/fr/longevity/"
        icon="lucide:sparkles"
        eyebrow="Pour les centres de bien-être et de longévité"
        title="Bien-être et longévité"
        body="Allongement des télomères, réduction des cellules sénescentes, amélioration cognitive, récupération sportive — protocoles, données et architecture de référence pour les centres."
        cta="Découvrir la longévité"
        variant="wellness"
      />
    </div>
  </section>

  {/* Shared library preview */}
  <section class="bg-slate-50 py-16 md:py-20 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <h2
          class="text-2xl md:text-3xl font-semibold text-slate-900"
          style="font-family: var(--font-display)"
        >
          Bibliothèque de référence
        </h2>
        <p class="mt-3 text-slate-600 leading-relaxed">
          Le même matériau source, organisé pour une consultation directe. Accessible
          depuis les deux parcours ci-dessus et depuis chaque page de détail du site.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <HomeLibraryTile
          href="/fr/mechanisms/"
          icon="lucide:atom"
          title="Mécanismes d'action"
          body="Cinq mécanismes physiologiques — hyperoxygénation, angiogenèse, action antimicrobienne, réduction du volume gazeux, voies anti-âge."
        />
        <HomeLibraryTile
          href="/fr/indications/"
          icon="lucide:list-checks"
          title="Indications"
          body={`${totalIndications} indications réparties en deux niveaux de preuve — ${fdaCount} couvrant les ${uhmsCount} indications approuvées par l'UHMS et ${emergingCount} fondées sur des données émergentes — avec niveaux de preuve, protocoles et références clés.`}
        />
        <HomeLibraryTile
          href="/fr/evidence/"
          icon="lucide:book-open"
          title="Base de preuves"
          body="Essais contrôlés randomisés (ECR), méta-analyses et études prospectives publiés dans des revues à comité de lecture — liens DOI vers les publications sources."
        />
        <HomeLibraryTile
          href="/fr/references/"
          icon="lucide:bookmark"
          title="Bibliographie"
          body="Toutes les sources citées, avec liens directs. Elles constituent l'ossature des citations de chaque affirmation du site."
        />
      </div>
    </div>
  </section>
</LandingLayout>
